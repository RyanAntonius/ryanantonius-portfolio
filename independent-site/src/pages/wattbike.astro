---
import EditableCopy from '../../components/EditableCopy.astro';
import '../../styles/project-navigation.css';

const media = (id: string) => `https://static.wixstatic.com/media/${id}`;
const renders = [
  media('97a2bb_485ea15636d84fddb655761f920ea092~mv2.png'), media('97a2bb_874c7a760d0c449db9e99c5637c2805a~mv2.jpg'), media('97a2bb_ae77c5d28655489bb24b8dc20fd9bc41~mv2.png'), media('97a2bb_c30971a737dd4e3d86a14b0a7d658825~mv2.jpg'), media('97a2bb_ffefb5acf61f4b8881882f6820d8abc8~mv2.jpg'), media('97a2bb_c921dbc7619f4db78ca83e8c9f7076c5~mv2.png'), media('97a2bb_5c2575f962644ec89eaeebcda648607f~mv2.png'), media('97a2bb_a58cb761a4ad4eaf8f1870925bfbd0f6~mv2.png'), media('97a2bb_3ed99529d85346f2b1abd40dbe76ebce~mv2.png'), media('97a2bb_98ebd00bcb6e4312bafb46828201daf1~mv2.jpg'), media('97a2bb_b97e294ee76b4915a7a1f9e1d783f355~mv2.png'),
];
const problems = [
  { title: 'Limited space', copy: 'Dense cities rarely have room for a dedicated bicycle shelter.', image: media('97a2bb_a61ba945558540aa86f0233a56785f5b~mv2.jpg') },
  { title: 'Bike litter', copy: 'Dockless bicycles can quickly create clutter across streets and pavements.', image: media('97a2bb_1b2a51ce1ef94ac099d1f848bd22b3c8~mv2.jpg') },
  { title: 'Daily maintenance', copy: 'Battery swaps and repairs often depend on a separate operator journey.', image: media('97a2bb_429d89ff05eb4ca3be4dc98711d3abfe~mv2.jpg') },
];
const features = [
  { number: '01', title: 'Integrated transfer', copy: 'The shelter becomes a convenient transfer point between bus, bicycle and the wider daily commute.', image: media('97a2bb_98ebd00bcb6e4312bafb46828201daf1~mv2.jpg') },
  { number: '02', title: 'Secure solar charging', copy: 'Docking, locking and charging are designed into one clear, sheltered interaction.', image: media('97a2bb_a58cb761a4ad4eaf8f1870925bfbd0f6~mv2.png') },
  { number: '03', title: 'Active public infrastructure', copy: 'A moving canopy makes renewable energy visible while improving the waiting environment.', image: media('97a2bb_b97e294ee76b4915a7a1f9e1d783f355~mv2.png') },
];
---
<EditableCopy />
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WATTBIKE — Ryan Antonius</title></head><body>
<header><a href="/">RYAN ANTONIUS</a><nav><a href="/industrial">WORK</a><a href="/#contact">CONTACT</a><a href="/about">ABOUT</a></nav></header>
<main>
  <section class="hero"><video autoplay muted loop playsinline poster={media('97a2bb_13aa5eccb7854e9c9115b2584e17b5ca~mv2.jpg')}><source src="https://video.wixstatic.com/video/97a2bb_826093e6a9694843aa080aef285140fa/1080p/mp4/file.mp4" type="video/mp4"/></video><div class="hero-copy"><p>URBAN SYSTEM · MICROMOBILITY</p><h1>WATTBIKE</h1><span>2020</span></div></section>
  <section class="overview"><div><p class="label">PROJECT OVERVIEW</p><h2>One shelter,<br/>more ways to move.</h2></div><div class="overview-copy"><p>WATTBIKE is a bicycle-sharing system that uses bus shelters as integrated hubs for commuters switching between modes of transport.</p><dl><div><dt>SERVICE</dt><dd>Product design</dd></div><div><dt>YEAR</dt><dd>2020</dd></div></dl></div></section>
  <section class="problem"><div class="section-heading"><p class="label">01 · THE OPPORTUNITY</p><h2>Why do bicycle-sharing systems fail?</h2><p>WATTBIKE starts with the realities that make shared mobility hard to sustain in a dense city.</p></div><div class="problem-grid">{problems.map((problem)=><article><img src={problem.image} alt={problem.title}/><span>{problem.title}</span><p>{problem.copy}</p></article>)}</div></section>
  <section class="response"><img src={renders[0]} alt="WATTBIKE station render"/><div><p class="label">02 · THE RESPONSE</p><h2>A hub built into the commute.</h2><p>The system combines protected parking, intelligent charging and a public waiting space, keeping bikes organised without demanding a separate footprint.</p></div></section>
  <section class="features">{features.map((feature)=><article><img src={feature.image} alt={feature.title}/><div><p class="label">{feature.number} · SERVICE FEATURE</p><h2>{feature.title}</h2><p>{feature.copy}</p></div></article>)}</section>
  <section class="technology"><div class="section-heading"><p class="label">03 · TECHNOLOGY</p><h2>Energy that follows the day.</h2><p>Charging stations are positioned for solar efficiency. The solar-tracking roof follows the sun’s path, keeping the photovoltaic cells oriented toward direct light and improving energy capture by an estimated 25–35%.</p></div><div class="technology-images"><img src={media('97a2bb_98ebd00bcb6e4312bafb46828201daf1~mv2.jpg')} alt="Solar canopy study"/><img src={media('97a2bb_b97e294ee76b4915a7a1f9e1d783f355~mv2.png')} alt="Solar tracking roof detail"/></div></section>
  <section class="development"><div class="section-heading"><p class="label">04 · VISUAL DEVELOPMENT</p><h2>System,<br/>made visible.</h2></div><div class="render-grid">{renders.filter((_, index) => index !== 2).map((image,index)=><button class:list={['image-button',{featured:index === 2 || index === 3}]} data-image={image}><img src={image} alt="WATTBIKE design render"/></button>)}</div></section>
  <section class="project-navigation"><a href="/industrial">← ALL INDUSTRIAL DESIGN</a><a href="/industrial/economy-butler"><span>NEXT PROJECT</span><strong>Economy Butler →</strong></a></section>
</main><footer>RYAN ANTONIUS © 2026</footer><dialog id="lightbox"><button class="close" aria-label="Close image">×</button><img alt="Expanded WATTBIKE image"/><button class="previous" aria-label="Previous image">←</button><button class="next" aria-label="Next image">→</button></dialog>
<script>const modal=document.querySelector('#lightbox'),large=modal?.querySelector('img');let active=0,activeGallery,touchX=0,touchY=0;const items=()=>activeGallery?[...activeGallery.querySelectorAll('.image-button')]:[];const show=(step=0)=>{const list=items();if(!list.length)return;active=(active+step+list.length)%list.length;if(large)large.src=list[active]?.dataset.image||''};document.querySelectorAll('.image-button').forEach(item=>item.addEventListener('click',()=>{activeGallery=item.closest('section');const list=items();active=list.indexOf(item);show();modal?.showModal()}));document.querySelector('.close')?.addEventListener('click',()=>modal?.close());document.querySelector('.previous')?.addEventListener('click',()=>show(-1));document.querySelector('.next')?.addEventListener('click',()=>show(1));document.addEventListener('keydown',event=>{if(!modal?.open)return;if(event.key==='ArrowLeft')show(-1);if(event.key==='ArrowRight')show(1);if(event.key==='Escape')modal.close()});modal?.addEventListener('touchstart',event=>{const touch=event.changedTouches[0];touchX=touch.clientX;touchY=touch.clientY},{passive:true});modal?.addEventListener('touchend',event=>{const touch=event.changedTouches[0],deltaX=touch.clientX-touchX,deltaY=touch.clientY-touchY;if(Math.abs(deltaX)>48&&Math.abs(deltaX)>Math.abs(deltaY))show(deltaX<0?1:-1)},{passive:true});</script>
</body></html>
<style>.development .render-grid{grid-template-columns:repeat(6,1fr)!important}.development .image-button{grid-column:span 2!important}.development .image-button.featured{grid-column:span 3!important;aspect-ratio:16/10!important}@media(max-width:760px){.development .render-grid{grid-template-columns:repeat(2,1fr)!important}.development .image-button,.development .image-button.featured{grid-column:span 1!important;aspect-ratio:4/3!important}.development .image-button.featured{grid-column:span 2!important;aspect-ratio:16/10!important}}</style>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#f4f2ed;color:#111310;font-family:Arial,Helvetica,sans-serif}:global(a){color:inherit;text-decoration:none}header{position:absolute;z-index:2;inset:0 0 auto;display:flex;justify-content:space-between;padding:28px 5.5vw;color:#fff;font-size:10px;font-weight:600;letter-spacing:.18em}header nav{display:flex;gap:27px}.hero{position:relative;height:min(86vh,900px);min-height:620px;background:#131513;overflow:hidden}.hero video{width:100%;height:100%;object-fit:cover}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.74),rgba(0,0,0,.1) 70%),linear-gradient(0deg,rgba(0,0,0,.62),transparent 48%)}.hero-copy{position:absolute;z-index:1;left:5.5vw;bottom:64px;color:#fff}.label,.hero-copy p{margin:0;font-size:10px;font-weight:600;letter-spacing:.2em}.hero-copy h1,.overview h2,.section-heading h2,.response h2,.features h2{margin:24px 0 0;font-weight:400;letter-spacing:-.075em;line-height:.88}.hero-copy h1{font-size:clamp(62px,9vw,132px)}.hero-copy span{display:block;margin-top:16px;font-size:13px}.overview{display:grid;grid-template-columns:1fr 1fr;gap:8vw;padding:110px 5.5vw;background:#191a18;color:#f6f5ef}.overview h2,.section-heading h2,.response h2{font-size:clamp(48px,5.8vw,86px)}.overview-copy{align-self:end;max-width:510px;font-size:18px;line-height:1.48}.overview-copy>p{margin:0 0 48px}.overview dl{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0}.overview dl div{border-top:1px solid rgba(255,255,255,.35);padding-top:12px}.overview dt{font-size:9px;font-weight:600;letter-spacing:.18em}.overview dd{margin:8px 0 0;font-size:14px}.problem,.technology,.development{padding:105px 5.5vw}.section-heading{max-width:650px}.section-heading h2{margin:27px 0}.section-heading>p:last-child{max-width:510px;margin:0;font-size:17px;line-height:1.5}.problem{background:#d8d5cc}.problem-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:58px}.problem-grid article{background:#efede7;padding-bottom:24px}.problem-grid img{display:block;width:100%;aspect-ratio:1;object-fit:cover}.problem-grid span{display:block;margin:18px 18px 8px;font-size:19px;letter-spacing:-.04em}.problem-grid p{margin:0 18px;font-size:14px;line-height:1.45}.response{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;background:#151614;color:#f5f4ef}.response>img{width:100%;height:650px;object-fit:cover}.response>div{max-width:510px;padding:70px 7vw}.response>div>p:last-child{margin:26px 0 0;font-size:17px;line-height:1.5}.features{background:#f7f6f1}.features article{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;min-height:490px;border-bottom:1px solid #c9c6bd}.features article:nth-child(even){grid-template-columns:1fr 1.1fr}.features article:nth-child(even) img{order:2}.features article img{width:100%;height:100%;min-height:490px;object-fit:cover}.features article div{max-width:470px;padding:64px 7vw}.features h2{font-size:clamp(39px,4.7vw,68px)}.features article div>p:last-child{margin:24px 0 0;font-size:16px;line-height:1.5}.technology{background:#d8d5cc}.technology-images{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:56px}.technology-images img{width:100%;height:410px;object-fit:cover}.development{background:#f7f6f1}.render-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:55px}.image-button{padding:0;border:0;aspect-ratio:4/3;overflow:hidden;background:#dbd9d2;cursor:zoom-in}.image-button img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .4s}.image-button:hover img{transform:scale(1.035)}.project-navigation{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:54px 5.5vw;background:#f2f0ea}.project-navigation a{min-height:118px;padding:24px;border:1px solid rgba(22,23,20,.34);display:flex;flex-direction:column;justify-content:center;font-size:10px;font-weight:600;letter-spacing:.16em}.project-navigation a:last-child{align-items:flex-end;text-align:right}.project-navigation span{font-size:9px;margin-bottom:13px;letter-spacing:.18em}.project-navigation strong{font-size:clamp(21px,2.3vw,34px);font-weight:400;letter-spacing:-.05em}footer{padding:28px 5.5vw;background:#090a09;color:#a5aaa2;font-size:9px;letter-spacing:.16em}:global(dialog){width:100vw;height:100vh;max-width:none;max-height:none;padding:0;border:0;background:rgba(0,0,0,.94)}:global(dialog[open]){display:flex;align-items:center;justify-content:center}:global(dialog img){max-width:86vw;max-height:86vh;object-fit:contain}:global(dialog button){position:absolute;width:48px;height:48px;border:1px solid #fff;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:22px}:global(dialog .close){right:24px;top:24px}:global(dialog .previous){left:24px}:global(dialog .next){right:24px}@media(max-width:760px){.hero{height:70svh;min-height:540px}.hero-copy{left:20px;bottom:42px}.hero-copy h1{font-size:clamp(58px,18vw,86px)}.overview,.problem,.technology,.development{display:block;padding:72px 20px}.overview h2,.section-heading h2{font-size:51px}.overview-copy{margin-top:55px;font-size:16px}.overview-copy>p{margin-bottom:38px}.problem-grid{grid-template-columns:1fr;gap:8px;margin-top:40px}.problem-grid article{display:grid;grid-template-columns:124px 1fr;padding:0}.problem-grid img{grid-row:1/3;aspect-ratio:auto;height:100%}.problem-grid span{margin:18px 16px 5px;font-size:17px}.problem-grid p{margin:0 16px 18px;font-size:13px}.response{display:flex;flex-direction:column}.response>img{height:330px}.response>div{padding:66px 20px}.response h2{font-size:49px}.response>div>p:last-child{font-size:16px}.features article,.features article:nth-child(even){display:flex;flex-direction:column;min-height:0}.features article:nth-child(even) img{order:0}.features article img{min-height:0;height:290px}.features article div{max-width:none;padding:55px 20px}.features h2{font-size:46px}.technology-images{grid-template-columns:1fr;gap:7px;margin-top:38px}.technology-images img{height:260px}.render-grid{grid-template-columns:repeat(2,1fr);gap:6px;margin-top:38px}.project-navigation{grid-template-columns:1fr;padding:34px 20px}.project-navigation a{min-height:92px;padding:20px}.project-navigation a:last-child{align-items:flex-start;text-align:left}}</style>
