---
import EditableCopy from '../components/EditableCopy.astro';
import '../styles/project-navigation.css';
const hero = 'https://video.wixstatic.com/video/97a2bb_5d5e860e29134b9892d34e50e86bfa7d/1080p/mp4/file.mp4';
const poster = 'https://static.wixstatic.com/media/97a2bb_21ef6f3be00742a4a6f2a60286dbb7e4~mv2.jpg';
const images = [
  'https://static.wixstatic.com/media/97a2bb_a3ed31c410264a85b9090c054b34e846~mv2.jpg',
  poster,
  'https://static.wixstatic.com/media/97a2bb_e09e05f23f9c4ae89708809e0511e05d~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_840483a0594c44e6a66a272f74871621~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_e02f1c91c7fe4675a8e33e7715029e12~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_375dcc44782144f4bb850a8e079919da~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_6352384c96614843a1320143f48708aa~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_ea5e4ef8c5f84d8dadcc181573b67012~mv2.jpg',
];
---
<EditableCopy />
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Ultimate Retail Demo — Ryan Antonius</title></head><body>
  <header class="nav"><a href="/">RYAN ANTONIUS</a><nav><a href="/#work">WORK</a><a href="/#contact">CONTACT</a><a href="/about">ABOUT</a></nav></header>
  <main>
    <section class="hero"><video autoplay muted loop playsinline poster={poster}><source src={hero} type="video/mp4" /></video><div class="shade"></div><div class="hero-copy"><p class="eyebrow">RAZER · ULTIMATE RETAIL DEMO</p><h1>Making product discovery tangible.</h1><p>A compact retail concept built to turn product exploration into a hands-on brand experience.</p></div><div class="meta">RETAIL DESIGN <span>2025</span><span>02 / 03</span></div></section>
    <section class="story" id="process"><div class="story-image"><img src={images[0]} alt="Ultimate Retail Demo concept" /></div><div><p class="eyebrow">CONCEPT DEVELOPMENT · RETAIL STRATEGY</p><h2>A flexible retail system.</h2><p>Designed as an adaptable demonstration environment, the concept brings product, play and brand storytelling into one clear customer journey.</p></div></section>
    <section class="steps"><div>01 · ATTRACT <span>Brand beacon</span></div><div>02 · DISCOVER <span>Product display</span></div><div>03 · EXPERIENCE <span>Hands-on demo</span></div><div>04 · CONNECT <span>Customer conversation</span></div></section>
    <section class="gallery-section" id="images"><p class="eyebrow">DESIGN DEVELOPMENT</p><h2>Renders</h2><div class="gallery" id="renders">{images.map((image, index) => <button class="image-button" data-group="renders" data-index={index} data-image={image}><img src={image} alt="Ultimate Retail Demo render" /></button>)}</div><div class="rail-actions"><button class="rail-arrow" data-rail="renders" data-direction="-1">←</button><button class="rail-arrow" data-rail="renders" data-direction="1">→</button></div></section>
    <section class="project-navigation"><a class="return-link" href="/retail">← BACK TO RETAIL DESIGN</a><a class="next-project" href="/retail/xperion-hamburg"><span>NEXT PROJECT</span><strong>XPERION Hamburg Shop-In-Shop →</strong></a></section>
  </main><footer><span>RYAN ANTONIUS © 2026</span><a href="/retail">BACK TO RETAIL DESIGN ↑</a></footer><dialog id="lightbox"><button class="close">×</button><button class="previous">←</button><img alt="Expanded project image" /><button class="next">→</button></dialog>
  <script>
    const modal=document.querySelector('#lightbox'), modalImage=modal?.querySelector('img'); let group='renders',index=0;
    const show=(change=0)=>{const items=[...document.querySelectorAll(`[data-group="${group}"]`)];index=(index+change+items.length)%items.length;if(modalImage)modalImage.src=items[index]?.dataset.image||''};
    document.querySelectorAll('.image-button').forEach(item=>item.addEventListener('click',()=>{group=item.dataset.group||'renders';index=Number(item.dataset.index||0);show();modal?.showModal()}));
    modal?.querySelector('.close')?.addEventListener('click',()=>modal.close());modal?.querySelector('.previous')?.addEventListener('click',()=>show(-1));modal?.querySelector('.next')?.addEventListener('click',()=>show(1));
    document.addEventListener('keydown',(event)=>{if(!modal?.open)return;if(event.key==='ArrowLeft'){event.preventDefault();show(-1)}if(event.key==='ArrowRight'){event.preventDefault();show(1)}});
    let touchX=0,touchY=0; modal?.addEventListener('touchstart',(event)=>{const touch=event.changedTouches[0];touchX=touch.clientX;touchY=touch.clientY},{passive:true}); modal?.addEventListener('touchend',(event)=>{const touch=event.changedTouches[0],deltaX=touch.clientX-touchX,deltaY=touch.clientY-touchY;if(Math.abs(deltaX)>48&&Math.abs(deltaX)>Math.abs(deltaY))show(deltaX<0?1:-1)},{passive:true});
    document.querySelectorAll('.rail-arrow').forEach(button=>button.addEventListener('click',()=>document.getElementById(button.dataset.rail||'')?.scrollBy({left:Number(button.dataset.direction||1)*window.innerWidth*.7,behavior:'smooth'})));
  </script>
</body></html>
<style>
  .back-retail{display:inline-flex;margin-top:24px;padding:11px 14px;border:1px solid rgba(255,255,255,.7);font-size:9px;font-weight:600;letter-spacing:.15em;transition:background .2s,color .2s}.back-retail:hover{background:#fff;color:#111310}@media(max-width:760px){.back-retail{margin-top:18px;padding:9px 11px;font-size:8px}}
  :global(*){box-sizing:border-box}:global(body){margin:0;font-family:Arial,Helvetica,sans-serif;background:#111310;color:#fff}.nav{position:absolute;z-index:2;top:0;left:0;right:0;display:flex;justify-content:space-between;padding:28px 5.5vw;font-size:10px;letter-spacing:.2em}.nav a,footer a{color:inherit;text-decoration:none}.nav nav{display:flex;gap:26px}.hero{height:88vh;min-height:680px;position:relative;display:flex;align-items:flex-end;background:#080a08;overflow:hidden}.hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.78),rgba(0,0,0,.08) 65%),linear-gradient(0deg,rgba(0,0,0,.68),transparent 48%)}.hero-copy,.meta{position:relative;z-index:1}.hero-copy{max-width:720px;padding:0 5.5vw 68px}.eyebrow{margin:0 0 16px;font-size:10px;font-weight:600;letter-spacing:.2em}.hero h1,.story h2,.gallery-section h2{margin:0;font-weight:400;line-height:.93;letter-spacing:-.065em}.hero h1{font-size:clamp(48px,6vw,88px)}.hero-copy>p:last-child{max-width:480px;margin:18px 0 0;font-size:15px;line-height:1.5;color:#d4d7d2}.meta{position:absolute;right:5.5vw;bottom:36px;display:flex;gap:24px;font-size:9px;letter-spacing:.17em}.story{display:grid;grid-template-columns:minmax(300px,1fr) 1.1fr;gap:7vw;align-items:center;padding:82px 8vw 52px;background:#e5e7e0;color:#111310}.story-image{min-height:280px}.story-image img{width:100%;height:100%;min-height:280px;object-fit:cover;display:block;filter:saturate(.82)}.story h2{font-size:clamp(40px,4.3vw,64px)}.story div:last-child>p:last-child{max-width:580px;font-size:16px;line-height:1.5}.steps{display:grid;grid-template-columns:repeat(4,1fr);padding:0 8vw 70px;background:#e5e7e0;color:#111310}.steps div{min-height:76px;padding:18px 16px;border:1px solid rgba(17,19,16,.18);border-right:0;font-size:10px;font-weight:600;letter-spacing:.14em}.steps div:last-child{border-right:1px solid rgba(17,19,16,.18)}.steps span{display:block;margin-top:8px;font-size:13px;font-weight:400;letter-spacing:0}.gallery-section{padding:58px 5.5vw 44px;background:#fff;color:#111310}.detail{border-top:1px solid #c9c6bd}.gallery-section h2{font-size:clamp(46px,5vw,72px)}.gallery{display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 0 12px}.image-button{flex:0 0 calc((100% - 24px)/4);min-width:250px;height:190px;padding:0;border:0;background:#eee;cursor:zoom-in;overflow:hidden;scroll-snap-align:start}.image-button img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .35s ease}.image-button:hover img{transform:scale(1.03)}.rail-actions{display:flex;justify-content:flex-end;gap:8px}.rail-arrow{width:38px;height:38px;border:1px solid #111;border-radius:50%;background:transparent;font-size:18px;cursor:pointer}footer{display:flex;justify-content:space-between;padding:28px 5.5vw;background:#090a09;color:#a5aaa2;font-size:9px;letter-spacing:.16em}:global(dialog){width:100vw;height:100vh;max-width:none;max-height:none;padding:0;border:0;background:rgba(0,0,0,.93)}:global(dialog[open]){display:flex;align-items:center;justify-content:center}:global(dialog img){max-width:86vw;max-height:86vh;object-fit:contain}:global(dialog button){position:absolute;width:48px;height:48px;border:1px solid #fff;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:22px;cursor:pointer}:global(dialog .close){top:24px;right:24px}:global(dialog .previous){left:24px}:global(dialog .next){right:24px}@media(max-width:760px){.nav{padding:16px 20px}.nav nav{gap:12px;font-size:8px}.hero{height:68svh;min-height:520px}.hero-copy{padding:0 20px 50px}.hero h1{font-size:clamp(42px,13vw,62px)}.meta{left:20px;right:auto;bottom:18px;font-size:7px;gap:12px}.story{grid-template-columns:1fr;padding:42px 20px 28px;gap:22px}.story-image,.story-image img{min-height:200px}.steps{grid-template-columns:1fr 1fr;padding:0 20px 40px}.steps div{border-right:1px solid rgba(17,19,16,.18)}.gallery-section{padding:38px 20px 30px}.image-button{flex-basis:82vw;min-width:82vw;height:auto;aspect-ratio:16/9}.gallery-section h2{font-size:54px}}
.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));overflow:visible}.image-button{min-width:0;width:auto;height:auto;aspect-ratio:16/9}.rail-actions{display:none}.project-navigation{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:54px 5.5vw;background:#e5e7e0;color:#111310}.project-navigation a{min-height:116px;padding:24px;border:1px solid rgba(17,19,16,.38);display:flex;flex-direction:column;justify-content:center;transition:background .2s,color .2s}.project-navigation a:hover{background:#111310;color:#fff}.return-link{font-size:11px;font-weight:600;letter-spacing:.15em}.next-project{align-items:flex-end;text-align:right}.next-project span{font-size:9px;letter-spacing:.18em;margin-bottom:10px}.next-project strong{font-size:clamp(20px,2.2vw,32px);font-weight:400;letter-spacing:-.04em}@media(max-width:760px){.gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.image-button{height:auto;aspect-ratio:1}.project-navigation{grid-template-columns:1fr;padding:34px 20px}.project-navigation a{min-height:92px;padding:20px}.next-project{align-items:flex-start;text-align:left}}
</style>
<style>@media(max-width:760px){.nav{height:64px;min-height:64px;padding:0 20px;align-items:center;font-size:9px}.nav>a{font-size:9px}.nav nav{gap:12px;font-size:8px}}</style>
