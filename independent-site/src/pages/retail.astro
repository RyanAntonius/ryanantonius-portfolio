---
<EditableCopy />
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Retail Design — Ryan Antonius</title></head><body>
  <header><a class="wordmark" href="/">RYAN ANTONIUS</a><nav><a href="/#work">WORK</a><a href="/#contact">CONTACT</a><a href="/about">ABOUT</a></nav></header>
  <main><section class="intro archive-hero"><div class="archive-rows hero-archive-rows">{archiveRows.map((row,index)=><div class:list={['archive-row',`row-${index + 1}`]}><div class="archive-track">{[...row,...row].map((image,tileIndex)=><figure class="archive-tile"><img src={image} alt="Retail project archive" loading={tileIndex < row.length ? 'eager' : 'lazy'} /></figure>)}</div></div>)}</div><div class="intro-copy"><p class="eyebrow">RETAIL DESIGN · SELECTED WORK</p><h1>Environments<br />built for discovery.</h1><p>Retail experiences where brand, product and customer flow work as one.</p></div></section>
  <section class="projects">{projects.map(project => <a href={project.href} class="project"><div class="image"><img src={project.image} alt={project.title} /></div><div class="caption"><span>{project.number}</span><div><h2>{project.title}</h2><p>Retail design</p></div><b>→</b></div></a>)}</section>
  <section class="closing"><p class="eyebrow">THE PRACTICE</p><p>From retail strategy to visualisation and proof of execution, every project is designed to give brands a physical presence.</p></section></main><footer><span>RYAN ANTONIUS © 2026</span><a href="/">BACK TO HOME ↑</a></footer><style>.archive-hero:after{background:linear-gradient(90deg,rgba(3,5,3,.72) 0%,rgba(3,5,3,.44) 36%,rgba(3,5,3,.1) 60%,rgba(3,5,3,0) 100%),linear-gradient(0deg,rgba(3,5,3,.3),transparent 55%)}.archive-hero .intro-copy h1{font-size:clamp(48px,6.3vw,96px)}@media(max-width:760px){main .archive-hero{min-height:660px!important;display:block!important;background:#f5f3ee;color:#11110f}.archive-hero:after{display:none}.hero-archive-rows{inset:auto 0 0!important;height:54%;grid-template-rows:repeat(2,1fr)!important}.hero-archive-rows .archive-row:nth-child(3){display:none}.archive-hero .intro-copy{position:absolute;inset:0 0 auto!important;height:46%;max-width:none!important;padding:48px 20px 28px!important;background:#f5f3ee}.archive-hero .intro-copy h1{font-size:clamp(42px,12vw,58px)!important}.archive-hero .intro-copy>p:last-child{max-width:280px;margin-top:18px!important;color:#383a35}.projects{grid-template-columns:repeat(2,minmax(0,1fr))!important}.projects .project:first-child{grid-column:1/-1}.projects .project:first-child .image{aspect-ratio:16/10}}</style>
<style>
  @media(max-width:760px){
    main .archive-hero{min-height:590px!important;display:flex!important;align-items:flex-end!important;background:#050605!important;color:#fff!important}
    .archive-hero:after{display:block!important;background:linear-gradient(90deg,rgba(0,0,0,.86),rgba(0,0,0,.42) 52%,rgba(0,0,0,.08))!important}
    .hero-archive-rows{inset:0!important;height:100%!important;grid-template-rows:repeat(3,1fr)!important;gap:5px!important;padding:5px 0!important}
    .hero-archive-rows .archive-row:nth-child(3){display:block!important}
    .archive-tile{width:180px!important;background:#000!important}
    .archive-hero .intro-copy{position:relative!important;inset:auto!important;height:auto!important;max-width:330px!important;padding:0 20px 44px!important;background:transparent!important}
    .archive-hero .intro-copy h1{font-size:clamp(38px,11vw,52px)!important}
    .archive-hero .intro-copy>p:last-child{margin-top:16px!important;color:rgba(255,255,255,.9)!important}
  }
</style></body></html>
<style>main .archive-hero{position:relative;isolation:isolate;display:flex;align-items:flex-end;min-height:clamp(520px,70vh,760px);padding:0;border-bottom:0;overflow:hidden;background:#111310;color:#f5f4ef}.hero-archive-rows{position:absolute;inset:0;z-index:-2;display:grid;grid-template-rows:repeat(3,1fr);gap:8px;padding:8px 0}.archive-row{overflow:hidden}.archive-track{display:flex;width:max-content;gap:8px;height:100%}.archive-row.row-1 .archive-track{animation:archive-left 92s linear infinite}.archive-row.row-2 .archive-track{animation:archive-right 106s linear infinite}.archive-row.row-3 .archive-track{animation:archive-left 96s linear infinite}.archive-tile{width:clamp(220px,26vw,390px);height:100%;flex:none;margin:0;overflow:hidden;background:#060806}.archive-tile img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(.86) contrast(1.07);transition:transform .5s ease}.archive-tile:hover img{transform:scale(1.06)}.archive-hero:after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(3,5,3,.9) 0%,rgba(3,5,3,.67) 40%,rgba(3,5,3,.22) 72%,rgba(3,5,3,.5)),linear-gradient(0deg,rgba(3,5,3,.55),transparent 55%)}.archive-hero .intro-copy{padding:clamp(55px,8vw,120px) clamp(20px,5vw,72px);max-width:900px}.archive-hero .intro-copy>p:last-child{max-width:430px;margin:36px 0 0;font-size:18px;line-height:1.4}@keyframes archive-left{to{transform:translateX(-50%)}}@keyframes archive-right{from{transform:translateX(-50%)}to{transform:translateX(0)}}@media(max-width:760px){main .archive-hero{min-height:580px}.hero-archive-rows{gap:5px;padding:5px 0}.archive-tile{width:250px}.archive-hero .intro-copy{padding:70px 20px 58px}.archive-hero .intro-copy>p:last-child{font-size:14px;margin-top:26px}}@media(prefers-reduced-motion:reduce){.archive-track{animation:none!important}}</style>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#f5f3ee;color:#11110f;font-family:Arial,Helvetica,sans-serif}:global(a){color:inherit;text-decoration:none}header{height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(20px,5vw,72px);border-bottom:1px solid #cbc8c0;font-size:10px;font-weight:600;letter-spacing:.18em}header nav{display:flex;gap:27px}.intro{min-height:460px;padding:clamp(80px,12vw,170px) clamp(20px,5vw,72px) 80px;border-bottom:1px solid #cbc8c0}.eyebrow{margin:0 0 18px;font-size:10px;font-weight:600;letter-spacing:.19em}.intro h1{max-width:850px;margin:0;font-size:clamp(55px,8vw,130px);font-weight:400;line-height:.88;letter-spacing:-.075em}.intro>p:last-child{max-width:430px;margin:36px 0 0;font-size:18px;line-height:1.4}.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding:clamp(50px,7vw,100px) clamp(20px,5vw,72px)}.image{aspect-ratio:1;overflow:hidden;background:#ddd}.image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s ease}.project:hover .image img{transform:scale(1.04)}.caption{display:grid;grid-template-columns:42px 1fr 22px;gap:10px;padding:14px 2px 17px;border-bottom:1px solid #cbc8c0;font-size:13px}.caption h2,.caption p{margin:0}.caption h2{font-size:14px;font-weight:500}.caption p{margin-top:4px;color:#6b6963;font-size:11px}.caption b{font-size:21px;font-weight:400}.closing{display:grid;grid-template-columns:1fr 1fr;gap:6vw;padding:60px clamp(20px,5vw,72px);border-top:1px solid #cbc8c0}.closing>p:last-child{max-width:500px;margin:0;font-size:20px;line-height:1.35}footer{display:flex;justify-content:space-between;padding:22px clamp(20px,5vw,72px);border-top:1px solid #cbc8c0;font-size:9px;letter-spacing:.12em}@media(max-width:760px){header{height:64px;padding:0 20px}header nav{gap:14px;font-size:8px}.intro{min-height:390px;padding:95px 20px 60px}.projects{grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;padding:46px 20px}.caption{grid-template-columns:22px 1fr;gap:7px;padding:10px 0 14px}.caption b{display:none}.caption h2{font-size:12px;line-height:1.15}.caption p{font-size:10px}.closing{grid-template-columns:1fr;padding:46px 20px;gap:20px}footer{padding:20px;font-size:8px}}
</style>
<style>@media(max-width:760px){header{height:64px;min-height:64px;padding:0 20px;align-items:center;font-size:9px}header nav{gap:12px;font-size:8px}}</style>
<style is:global>@media(max-width:760px){main .archive-hero{height:560px!important;min-height:560px!important}.hero-archive-rows{inset:0!important;height:100%!important;grid-template-rows:repeat(3,minmax(0,1fr))!important}.hero-archive-rows .archive-row:nth-child(3){display:block!important}.archive-row{min-height:0!important}.archive-tile{width:180px!important;height:100%!important}.archive-hero .intro-copy{position:relative!important;inset:auto!important;max-width:310px!important;padding:0 20px 30px!important;background:transparent!important}.archive-hero .intro-copy h1{font-size:clamp(38px,10vw,46px)!important;line-height:.93!important}.archive-hero .intro-copy>p:last-child{margin-top:14px!important;font-size:13px!important;line-height:1.45!important}}</style>
