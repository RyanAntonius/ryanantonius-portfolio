<script>
  document.querySelectorAll('header').forEach((header) => {
    const navigation = header.querySelector('nav');
    if (!navigation) return;
    let menu = header.querySelector('.menu');
    if (menu) return;
    navigation.id ||= `mobile-navigation-${Math.random().toString(36).slice(2, 8)}`;
    menu = document.createElement('button');
    menu.className = 'menu';
    menu.type = 'button';
    menu.setAttribute('aria-label', 'Open navigation');
    menu.setAttribute('aria-expanded', 'false');
    menu.setAttribute('aria-controls', navigation.id);
    menu.innerHTML = '<i></i><i></i>';
    header.append(menu);
    const close = () => {
      header.classList.remove('is-open');
      menu?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-label', 'Open navigation');
    };
    menu.addEventListener('click', () => {
      const open = !header.classList.contains('is-open');
      header.classList.toggle('is-open', open);
      menu?.setAttribute('aria-expanded', String(open));
      menu?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    });
    navigation.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
  });

  document.querySelectorAll('dialog').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      if (window.matchMedia('(max-width: 760px)').matches && event.target === dialog) dialog.close();
    });
  });
</script>
<style is:global>
  header, header.nav{height:82px!important;min-height:82px!important;padding:0 clamp(20px,5.5vw,72px)!important;display:flex!important;align-items:center!important;justify-content:space-between!important}
  header>a:first-child{font-size:13px!important;font-weight:600!important;letter-spacing:.15em!important}
  header nav{gap:27px!important;font-size:10px!important;letter-spacing:.18em!important}
  header .menu{display:none!important}
  @media(max-width:760px){header,header.nav{height:64px!important;min-height:64px!important;padding:0 20px!important}header>a:first-child{font-size:12px!important}header nav{gap:16px!important;font-size:9px!important}header .menu{display:block!important;width:32px!important;padding:5px!important;border:0!important;background:transparent!important;color:inherit!important;cursor:pointer!important}header .menu i{display:block!important;height:1px!important;margin:6px 0!important;background:currentColor!important;transition:transform .2s ease!important}header:not(.is-open) nav{display:none!important}header.is-open{background:#090a09!important}header.is-open nav{position:absolute!important;z-index:10!important;top:64px!important;left:0!important;right:0!important;display:flex!important;flex-direction:column!important;gap:0!important;padding:10px 20px 18px!important;background:#090a09!important;font-size:10px!important;letter-spacing:.16em!important}header.is-open nav a{padding:14px 0!important;border-top:1px solid rgba(255,255,255,.18)!important}header.is-open .menu i:first-child{transform:translateY(3.5px) rotate(45deg)!important}header.is-open .menu i:last-child{transform:translateY(-3.5px) rotate(-45deg)!important}}
</style>
