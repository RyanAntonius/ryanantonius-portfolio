---
import EditableCopy from '../../components/EditableCopy.astro';
import { industrialProjects } from '../../data/industrial';
---
<EditableCopy />
<style is:global>@media(max-width:760px){header{height:64px!important;min-height:64px!important;padding:0 20px!important;align-items:center!important;font-size:9px!important}header nav{gap:12px!important;font-size:8px!important}}</style>
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Industrial Design — Ryan Antonius</title></head><body>
<header><a href="/">RYAN ANTONIUS</a><nav><a href="/#work">WORK</a><a href="/#contact">CONTACT</a><a href="/about">ABOUT</a></nav></header>
<main><section class="intro"><p>03 · SELECTED WORK</p><h1>Industrial design</h1><span>09 PROJECTS · 2017—2021</span></section><section class="projects">{industrialProjects.map((project,index)=><a href={`/industrial/${project.slug}`} class:list={['project',{featured:project.featured}]}><div class="image"><img src={project.cardImage || project.hero} alt={project.title}/></div><div class="caption"><span>{String(index+1).padStart(2,'0')}</span><div><p>{project.featured ? 'FEATURED PROJECT' : `${project.eyebrow.split(' · ')[0]} · ${project.year}`}</p><h2>{project.title}</h2></div><b>→</b></div></a>)}</section></main><footer>RYAN ANTONIUS © 2026</footer>
</body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#f5f3ee;color:#111310;font-family:Arial,Helvetica,sans-serif}:global(a){color:inherit;text-decoration:none}header{display:flex;justify-content:space-between;padding:28px 5.5vw;font-size:10px;font-weight:600;letter-spacing:.18em}header nav{display:flex;gap:27px}.intro{padding:105px 5.5vw 72px;border-bottom:1px solid #c9c6bd}.intro p,.intro span{font-size:10px;font-weight:600;letter-spacing:.18em}.intro p{margin:0}.intro h1{margin:28px 0 40px;font-size:clamp(64px,8vw,122px);font-weight:400;letter-spacing:-.08em;line-height:.85}.projects{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:54px 18px;padding:70px 5.5vw 120px}.image{aspect-ratio:1;overflow:hidden;background:#dbd9d2}.image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s}.caption{display:grid;grid-template-columns:38px 1fr 20px;gap:8px;padding:14px 0 18px;border-bottom:1px solid #c9c6bd}.caption>span{font-size:11px}.caption p,.caption h2{margin:0}.caption p{margin-bottom:7px;font-size:9px;font-weight:600;letter-spacing:.15em}.caption h2{font-size:20px;font-weight:400;letter-spacing:-.04em}.caption b{font-size:20px;font-weight:400}.project:hover .image img{transform:scale(1.045)}.project:hover h2{text-decoration:underline;text-underline-offset:5px}.featured .image{box-shadow:inset 0 0 0 1px #111310}footer{padding:28px 5.5vw;background:#090a09;color:#a5aaa2;font-size:9px;letter-spacing:.16em}@media(max-width:760px){header{padding:20px;font-size:9px}header nav{gap:13px;font-size:8px}.intro{padding:74px 20px 48px}.intro h1{font-size:clamp(54px,16vw,76px);margin:26px 0 32px}.projects{grid-template-columns:repeat(2,minmax(0,1fr));gap:29px 13px;padding:42px 20px 70px}.image{aspect-ratio:1}.caption{grid-template-columns:21px 1fr;padding:10px 0 14px;gap:7px}.caption b{display:none}.caption>span{font-size:10px}.caption p{font-size:7px;margin-bottom:4px}.caption h2{font-size:15px;line-height:1.05}.project:first-child{grid-column:1/-1}.project:first-child .image{aspect-ratio:16/10}.project:first-child .caption h2{font-size:18px}}</style>
