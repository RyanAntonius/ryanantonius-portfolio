---
import EditableCopy from '../../components/EditableCopy.astro';
import { getIndustrialProject, industrialProjects } from '../../data/industrial';
import '../../styles/project-navigation.css';
const slug = Astro.params.slug || 'aero';
const project = getIndustrialProject(slug);
const index = industrialProjects.findIndex((item) => item.slug === project.slug);
const next = industrialProjects[(index + 1) % industrialProjects.length];
const narratives: Record<string, { researchTitle: string; researchCopy: string; features: { label: string; title: string; copy: string; image: string }[] }> = {
  steamway: {
    researchTitle: 'Steam makes a little water go further.',
    researchCopy: 'Steam expands from a small amount of water, helping it reach surfaces with less consumption. It also sanitises dishes without relying on chemical detergents.',
    features: [
      { label: '02 · ORGANISATION', title: 'Wash, store and put away in one flow.', copy: 'Removable baskets let dishes move directly from cupboard to machine and back again, making the everyday routine easier to organise.', image: project.renders[1] },
      { label: '03 · FILTRATION', title: 'Designed around reuse.', copy: 'Reusable filters are rinsed after a few cycles and replaced only when needed, reducing waste alongside water use.', image: 'https://static.wixstatic.com/media/97a2bb_71be2975744143ad98b5e08d717dd3dc~mv2.jpg' },
    ],
  },
  bonfire: {
    researchTitle: 'A disposable straw can become a lasting material.',
    researchCopy: 'Single-use plastic straws are easily lost to the natural environment. Bonfire begins by treating this difficult waste stream as an expressive material instead of hiding it.',
    features: [
      { label: '02 · MATERIAL MAKING', title: 'Heat reforms every straw into a unique curve.', copy: 'Straight recycled straws are cut and reshaped by hand. Their irregularity becomes the lamp’s flame-like character.', image: 'https://static.wixstatic.com/media/97a2bb_4885d78faf734648b52089f2156fd32e~mv2.jpg' },
      { label: '03 · END OF LIFE', title: 'Three parts. No glue. No paint.', copy: 'The wooden base, light diffuser and reformed straws separate cleanly, keeping the lamp easy to repair and recycle.', image: 'https://static.wixstatic.com/media/97a2bb_38946355313b43d1ac1d06917d1a62d0~mv2.jpg' },
    ],
  },
};
const narrative = narratives[project.slug];
---
<EditableCopy />
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{project.title} — Ryan Antonius</title></head><body>
<header><a href="/">RYAN ANTONIUS</a><nav><a href="/industrial">WORK</a><a href="/#contact">CONTACT</a><a href="/about">ABOUT</a></nav></header>
<main>
  <style>.narrative-features{background:#f7f6f1}.narrative-features article{display:grid;grid-template-columns:1fr 1fr;align-items:center;min-height:500px;border-top:1px solid #cbc8c0}.narrative-features article.reverse img{order:2}.narrative-features article img{width:100%;height:500px;object-fit:cover}.narrative-features article div{max-width:540px;padding:72px 7vw}.narrative-features h2{margin:24px 0 0;font-size:clamp(42px,5vw,72px);font-weight:400;letter-spacing:-.075em;line-height:.9}.narrative-features div>p:last-child{font-size:16px;line-height:1.5}@media(max-width:760px){.narrative-features article,.narrative-features article.reverse{display:flex;flex-direction:column}.narrative-features article.reverse img{order:0}.narrative-features article img{height:300px}.narrative-features article div{max-width:none;padding:56px 20px}.narrative-features h2{font-size:47px}}</style>
  <section class="hero">{project.heroVideo ? <video autoplay muted loop playsinline poster={project.hero}><source src={project.heroVideo} type="video/mp4"/></video> : <img src={project.hero} alt={project.title}/>}<div class="hero-copy"><p>{project.eyebrow}</p><h1>{project.title}</h1><span>{project.year}</span></div></section>
  <section class="brief"><div><p>PROJECT OVERVIEW</p><h2>{project.statement}</h2></div><p>{project.overview}</p></section>
  {narrative ? <><section class="story"><div class="story-copy"><p class="label">01 · RESEARCH</p><h2>{narrative.researchTitle}</h2><p>{narrative.researchCopy}</p></div><img src={project.slug === 'bonfire' ? 'https://static.wixstatic.com/media/97a2bb_d681c085d2f74e1681e5711bf4583f65~mv2.jpg' : project.renders[0]} alt={`${project.title} research`}/></section><section class="narrative-features">{narrative.features.map((feature, featureIndex) => <article class:list={{ reverse: featureIndex % 2 === 1 }}><img src={feature.image} alt={`${project.title} ${feature.label.toLowerCase()}`}/><div><p class="label">{feature.label}</p><h2>{feature.title}</h2><p>{feature.copy}</p></div></article>)}</section><section class="development"><div class="section-title"><p>DESIGN DETAILS</p><h2>The system,<br/>made visible.</h2></div><div class="render-grid">{(project.slug === 'bonfire' ? project.renders.slice(0, 1) : project.renders).map((image)=><button class="image-button" data-image={image}><img src={image} alt={`${project.title} render`}/></button>)}</div></section></> : <><section class="story"><div class="story-copy"><p class="label">01 · DESIGN INTENT</p><h2>Design intent</h2><p>{project.challenge}</p></div><img src={project.storyVisual || project.renders[0]} alt={`${project.title} design development`}/></section><section class="development"><div class="section-title"><p>02 · VISUAL DEVELOPMENT</p><h2>Form,<br/>made visible.</h2></div><div class="render-grid">{project.renders.map((image)=><button class="image-button" data-image={image}><img src={image} alt={`${project.title} render`}/></button>)}</div></section></>}
  {project.prototypes.length > 0 && <><section class="story reverse"><img src={project.prototypes[0]} alt={`${project.title} prototype`}/><div><p class="label">03 · PROTOTYPING & TESTING</p><h2>From idea to evidence</h2><p>{project.outcome}</p></div></section><section class="development prototype-section"><div class="section-title"><p>PROCESS EVIDENCE</p><h2>Materials,<br/>models, proof.</h2></div><div class="render-grid">{project.prototypes.map((image)=><button class="image-button" data-image={image}><img src={image} alt={`${project.title} prototype`}/></button>)}</div></section></>}
  <section class="navigation"><a href="/industrial">← ALL INDUSTRIAL DESIGN</a><a href={`/industrial/${next.slug}`}><span>NEXT PROJECT</span><strong>{next.title} →</strong></a></section>
</main><footer>RYAN ANTONIUS © 2026</footer><dialog id="lightbox"><button class="close" aria-label="Close image">×</button><button class="previous" aria-label="Previous image">←</button><img alt="Expanded project image"/><button class="next" aria-label="Next image">→</button></dialog>
<script>const modal=document.querySelector('#lightbox'),large=modal?.querySelector('img');let active=0,activeGallery,touchX=0,touchY=0;const items=()=>activeGallery?[...activeGallery.querySelectorAll('.image-button')]:[];const show=(step=0)=>{const list=items();if(!list.length)return;active=(active+step+list.length)%list.length;if(large)large.src=list[active]?.dataset.image||''};document.querySelectorAll('.image-button').forEach(item=>item.addEventListener('click',()=>{activeGallery=item.closest('section');const list=items();active=list.indexOf(item);show();modal?.showModal()}));document.querySelector('.close')?.addEventListener('click',()=>modal?.close());document.querySelector('.previous')?.addEventListener('click',()=>show(-1));document.querySelector('.next')?.addEventListener('click',()=>show(1));document.addEventListener('keydown',(event)=>{if(!modal?.open)return;if(event.key==='ArrowLeft')show(-1);if(event.key==='ArrowRight')show(1);if(event.key==='Escape')modal.close()});modal?.addEventListener('touchstart',event=>{const touch=event.changedTouches[0];touchX=touch.clientX;touchY=touch.clientY},{passive:true});modal?.addEventListener('touchend',event=>{const touch=event.changedTouches[0],deltaX=touch.clientX-touchX,deltaY=touch.clientY-touchY;if(Math.abs(deltaX)>48&&Math.abs(deltaX)>Math.abs(deltaY))show(deltaX<0?1:-1)},{passive:true});</script>
</body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#f2f0ea;color:#161714;font-family:Arial,Helvetica,sans-serif}:global(a){color:inherit;text-decoration:none}header{position:absolute;z-index:3;inset:0 0 auto;display:flex;justify-content:space-between;padding:28px 5.5vw;color:#fff;font-size:10px;font-weight:600;letter-spacing:.18em}header nav{display:flex;gap:27px}.hero{position:relative;height:min(86vh,900px);min-height:620px;overflow:hidden;background:#1a1b19}.hero>img,.hero>video{width:100%;height:100%;object-fit:cover}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.76),rgba(0,0,0,.1) 68%),linear-gradient(0deg,rgba(0,0,0,.6),transparent 45%)}.hero-copy{position:absolute;z-index:1;left:5.5vw;bottom:64px;color:#fff}.hero-copy p,.label,.section-title p,.brief p:first-child{margin:0;font-size:10px;font-weight:600;letter-spacing:.2em}.hero-copy h1{margin:22px 0 14px;font-size:clamp(58px,8vw,126px);font-weight:400;letter-spacing:-.08em;line-height:.84}.hero-copy span{font-size:13px}.brief{display:grid;grid-template-columns:1fr 1fr;gap:8vw;padding:105px 5.5vw;background:#191a18;color:#f7f6f0}.brief h2,.story h2,.section-title h2{margin:28px 0 0;font-size:clamp(42px,5.5vw,82px);font-weight:400;letter-spacing:-.075em;line-height:.9}.brief>p{align-self:end;max-width:450px;margin:0;font-size:18px;line-height:1.48}.story{display:grid;grid-template-columns:1fr 1fr;gap:8vw;padding:105px 5.5vw;background:#d8d4cb;align-items:center}.story-copy{max-width:500px}.story-copy p:last-child{max-width:430px;font-size:16px;line-height:1.48}.story>img{width:100%;height:390px;object-fit:cover;background:#bcb9b1}.story.reverse{grid-template-columns:1fr 1fr;padding:0;background:#151614;color:#f5f4ef}.story.reverse>img{height:580px}.story.reverse>div{padding:110px max(5.5vw,60px);align-self:center}.story.reverse h2{margin-top:26px}.story.reverse p:last-child{font-size:17px;line-height:1.5}.development{padding:105px 5.5vw;background:#f7f6f1}.section-title{max-width:570px;margin-bottom:52px}.render-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.image-button{padding:0;border:0;aspect-ratio:4/3;overflow:hidden;background:#dbd9d2;cursor:zoom-in}.image-button img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s}.image-button:hover img{transform:scale(1.035)}.prototype-section{background:#d8d4cb}.navigation{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:54px 5.5vw;background:#f2f0ea}.navigation a{min-height:118px;padding:24px;border:1px solid rgba(22,23,20,.34);display:flex;flex-direction:column;justify-content:center;font-size:10px;font-weight:600;letter-spacing:.16em}.navigation a:last-child{align-items:flex-end;text-align:right}.navigation span{font-size:9px;margin-bottom:13px;letter-spacing:.18em}.navigation strong{font-size:clamp(21px,2.3vw,34px);font-weight:400;letter-spacing:-.05em}footer{padding:28px 5.5vw;background:#090a09;color:#a5aaa2;font-size:9px;letter-spacing:.16em}:global(dialog){width:100vw;height:100vh;max-width:none;max-height:none;padding:0;border:0;background:rgba(0,0,0,.94)}:global(dialog[open]){display:flex;align-items:center;justify-content:center}:global(dialog img){max-width:86vw;max-height:86vh;object-fit:contain}:global(dialog button){position:absolute;width:48px;height:48px;border:1px solid #fff;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:22px}:global(dialog .close){right:24px;top:24px}:global(dialog .previous){left:24px}:global(dialog .next){right:24px}@media(max-width:760px){header{padding:20px;font-size:9px}header nav{gap:13px;font-size:8px}.hero{height:70svh;min-height:540px}.hero-copy{left:20px;bottom:42px}.hero-copy h1{font-size:clamp(58px,18vw,86px)}.brief{display:block;padding:76px 20px}.brief h2{font-size:52px;margin-bottom:55px}.brief>p{font-size:16px}.story{display:block;padding:68px 20px}.story-copy{margin:0 0 36px}.story h2{font-size:47px}.story-copy p:last-child{font-size:15px}.story>img{height:290px}.story.reverse{display:flex;flex-direction:column-reverse}.story.reverse>img{height:310px}.story.reverse>div{padding:68px 20px;margin:0}.story.reverse h2{font-size:47px}.development{padding:70px 20px}.section-title{margin-bottom:34px}.section-title h2{font-size:52px}.render-grid{grid-template-columns:repeat(2,1fr);gap:6px}.navigation{grid-template-columns:1fr;padding:34px 20px}.navigation a{min-height:92px;padding:20px}.navigation a:last-child{align-items:flex-start;text-align:left}}</style>
