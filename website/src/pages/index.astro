<style is:global>@media(max-width:760px){.hero{height:560px!important;min-height:560px!important}.hero-media,.hero-shade{inset:0!important}.hero-media img{object-fit:cover!important;object-position:center center!important}.hero-copy{position:absolute!important;top:auto!important;bottom:30px!important;max-width:310px!important;padding:0 20px!important}.hero h1{font-size:clamp(38px,10vw,46px)!important;line-height:.93!important}.categories{margin:14px 0 18px!important;line-height:1.7!important}.button{padding:13px 16px!important}.nav{background:transparent!important}}</style>
<style is:global>@media(max-width:760px){.nav.is-open{background:#090a09!important}.nav.is-open nav{position:absolute;top:64px;left:0;right:0;display:flex!important;flex-direction:column;gap:0;padding:10px 20px 18px;background:#090a09;font-size:10px;letter-spacing:.16em}.nav.is-open nav a{padding:14px 0;border-top:1px solid rgba(255,255,255,.18)}.menu i{transition:transform .2s ease}.nav.is-open .menu i:first-child{transform:translateY(3.5px) rotate(45deg)}.nav.is-open .menu i:last-child{transform:translateY(-3.5px) rotate(-45deg)}}</style>
