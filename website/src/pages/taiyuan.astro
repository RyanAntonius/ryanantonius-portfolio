---
import EditableCopy from '../components/EditableCopy.astro';
import '../styles/project-navigation.css';
const taiyuanImage = 'https://static.wixstatic.com/media/97a2bb_1629d32ad7fc4dee94f9147b8faa0f11~mv2.jpg';
const taiyuanAnimation = 'https://video.wixstatic.com/video/97a2bb_a43364a9260f44b4b0fd2bc3d761be5a/1080p/mp4/file.mp4';
const floorplan = 'https://static.wixstatic.com/media/97a2bb_d35d71908d8547368c86eb148d467996~mv2.png';
const renders = [
  taiyuanImage,
  'https://static.wixstatic.com/media/97a2bb_aa9a6041e9a043b191eb4cb6f3970a0e~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_ef829c465e5241f79c08a9628d4bc76e~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_2ec019e22a0f414ebab64f483c71c89e~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_109c61e8df6240f2a7d6b67b33e64033~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_b6275cbca592466c9bccc8c155a1c6e7~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_4033c963cc0d4cda8e3f7cba22a86cf7~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_3aa1ca1444e7418a82c8d3fdaac731fa~mv2.jpg',
];
const execution = [
  'https://static.wixstatic.com/media/97a2bb_c1fe7b3b545b476091365ba216692e26~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_5821de417bc246de9bb1f69389c86ff7~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_41c840628c9c4e309fd6ed0898a9ee96~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_5c3f1fb7109a45e0a1138730ecc4d477~mv2.jpg',
  'https://static.wixstatic.com/media/97a2bb_cbc64684a78448e8a86249981f7a8726~mv2.jpg',
];
---
<EditableCopy />
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RazerStore Taiyuan — Ryan Antonius</title>
  </head>
  <body>
    <header class="nav"><a href="/">RYAN ANTONIUS</a><nav><a href="/#work">WORK</a><a href="/#contact">CONTACT</a><a href="/about">ABOUT</a></nav></header>
    <main>
      <section class="hero">
        <video class="hero-video" autoplay muted loop playsinline poster={taiyuanImage} aria-label="Animated RazerStore Taiyuan concept"><source src={taiyuanAnimation} type="video/mp4" /></video>
        <div class="hero-shade"></div>
        <div class="hero-copy"><p class="eyebrow">RAZER FLAGSHIP STORE · TAIYUAN</p><h1>A flagship made for discovery and play.</h1><p>A retail environment that brings product exploration, gaming culture and brand presence into one fluid customer journey.</p></div>
        <div class="meta">RETAIL DESIGN <span>2025</span><span>01 / 01</span></div>
      </section>

      <section class="story" id="process">
        <div class="story-plan"><div class="plan-surface"><img src={floorplan} alt="RazerStore Taiyuan floorplan" /></div></div>
        <div><p class="eyebrow">CONCEPT DEVELOPMENT · SPATIAL STRATEGY</p><h2>Designing the customer journey.</h2><p class="lead">From a strategic floorplan to an animated concept and finally an executed flagship environment, every spatial decision supports how customers discover, explore and play.</p></div>
      </section>
      <section class="journey"><div>01 · DISCOVER <span>Category wall</span></div><div>02 · EXPLORE <span>Product tables</span></div><div>03 · PLAY <span>Console zone</span></div><div>04 · FLOW <span>Customer circulation</span></div></section>

      <section class="gallery-section" id="images">
        <p class="eyebrow">DESIGN DEVELOPMENT</p><h2>Renders</h2>
        <div class="rail-shell"><div class="gallery" id="render-gallery">{renders.map((image, index) => <button class="image-button" data-image={image} data-group="renders" data-index={index} aria-label="Open Taiyuan render"><img src={image} alt="RazerStore Taiyuan render" /></button>)}</div><div class="rail-actions"><button class="rail-arrow" data-rail="render-gallery" data-direction="-1" aria-label="Previous renders">←</button><button class="rail-arrow" data-rail="render-gallery" data-direction="1" aria-label="More renders">→</button></div></div>
      </section>
      <section class="gallery-section execution"><p class="eyebrow">PROOF OF EXECUTION</p><h2>Built reality</h2><div class="rail-shell"><div class="gallery" id="execution-gallery">{execution.map((image, index) => <button class="image-button" data-image={image} data-group="execution" data-index={index} aria-label="Open Taiyuan execution image"><img src={image} alt="RazerStore Taiyuan execution" /></button>)}</div><div class="rail-actions"><button class="rail-arrow" data-rail="execution-gallery" data-direction="-1" aria-label="Previous execution images">←</button><button class="rail-arrow" data-rail="execution-gallery" data-direction="1" aria-label="More execution images">→</button></div></div></section>
      <section class="project-navigation"><a class="return-link" href="/retail">← BACK TO RETAIL DESIGN</a><a class="next-project" href="/ultimate-retail-demo"><span>NEXT PROJECT</span><strong>Ultimate Retail Demo →</strong></a></section>
    </main>
    <footer><span>RYAN ANTONIUS © 2026</span><a href="/retail">BACK TO RETAIL DESIGN ↑</a></footer>
    <dialog id="lightbox"><button class="lightbox-close" aria-label="Close image">×</button><button class="lightbox-arrow previous" aria-label="Previous image">←</button><img alt="Expanded project image" /><button class="lightbox-arrow next" aria-label="Next image">→</button></dialog>
    <script>
      const lightbox = document.querySelector('#lightbox');
      const lightboxImage = lightbox?.querySelector('img');
      let activeGroup = 'renders'; let activeIndex = 0;
      const showLightboxImage = (direction = 0) => {
        const images = [...document.querySelectorAll(`.image-button[data-group="${activeGroup}"]`)];
        activeIndex = (activeIndex + direction + images.length) % images.length;
        if (lightboxImage) lightboxImage.src = images[activeIndex]?.dataset.image || '';
      };
      document.querySelectorAll('.image-button').forEach((button) => button.addEventListener('click', () => { activeGroup = button.dataset.group || 'renders'; activeIndex = Number(button.dataset.index || 0); showLightboxImage(); lightbox?.showModal(); }));
      lightbox?.querySelector('.lightbox-close')?.addEventListener('click', () => lightbox.close());
      lightbox?.querySelector('.previous')?.addEventListener('click', () => showLightboxImage(-1));
      lightbox?.querySelector('.next')?.addEventListener('click', () => showLightboxImage(1));
      document.addEventListener('keydown', (event) => { if (!lightbox?.open) return; if (event.key === 'ArrowLeft') { event.preventDefault(); showLightboxImage(-1); } if (event.key === 'ArrowRight') { event.preventDefault(); showLightboxImage(1); } });
      let touchX = 0, touchY = 0;
      lightbox?.addEventListener('touchstart', (event) => { const touch = event.changedTouches[0]; touchX = touch.clientX; touchY = touch.clientY; }, { passive: true });
      lightbox?.addEventListener('touchend', (event) => { const touch = event.changedTouches[0], deltaX = touch.clientX - touchX, deltaY = touch.clientY - touchY; if (Math.abs(deltaX) > 48 && Math.abs(deltaX) > Math.abs(deltaY)) showLightboxImage(deltaX < 0 ? 1 : -1); }, { passive: true });
      document.querySelectorAll('.rail-arrow').forEach((button) => button.addEventListener('click', () => {
        const rail = document.getElementById(button.dataset.rail || '');
        rail?.scrollBy({ left: Number(button.dataset.direction || 1) * rail.clientWidth * .82, behavior: 'smooth' });
      }));

    </script>
  </body>
</html>

<style>
  .back-retail{display:inline-flex;margin-top:24px;padding:11px 14px;border:1px solid rgba(255,255,255,.7);font-size:9px;font-weight:600;letter-spacing:.15em;transition:background .2s,color .2s}.back-retail:hover{background:#fff;color:#111310}@media(max-width:760px){.back-retail{margin-top:18px;padding:9px 11px;font-size:8px}}
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#111310;color:#fff;font-family:Arial,Helvetica,sans-serif}:global(a){color:inherit;text-decoration:none}.nav{position:absolute;z-index:2;top:0;left:0;right:0;display:flex;justify-content:space-between;padding:28px 5.5vw;font-size:10px;letter-spacing:.2em}.nav nav{display:flex;gap:26px}.hero{min-height:720px;height:88vh;position:relative;display:flex;align-items:flex-end;background-size:cover;background-position:center}.hero-copy{max-width:730px;padding:0 5.5vw 68px}.eyebrow{margin:0 0 16px;font-size:10px;font-weight:600;letter-spacing:.2em}.hero h1,.story h2,.gallery-section h2{margin:0;letter-spacing:-.065em;font-weight:400;line-height:.93}.hero h1{max-width:650px;font-size:clamp(44px,6vw,88px)}.hero-copy>p:last-child{max-width:500px;margin:18px 0 0;color:rgba(255,255,255,.82);font-size:15px;line-height:1.5}.meta{position:absolute;right:5.5vw;bottom:36px;display:flex;gap:24px;font-size:9px;letter-spacing:.17em}.story{display:grid;grid-template-columns:minmax(300px,1fr) minmax(360px,1.1fr);gap:7vw;align-items:center;padding:82px 8vw 52px;background:#e5e7e0;color:#111310}.story-plan{min-height:280px;position:relative}.plan-surface{position:absolute;inset:35px 0 0;display:grid;place-items:center;border:1px solid rgba(17,19,16,.16);transform:rotate(-3deg);background:linear-gradient(135deg,rgba(255,255,255,.4),transparent)}.plan-surface:before,.plan-surface:after{content:'';position:absolute;border:1px solid rgba(17,19,16,.22);inset:20% 12%}.plan-surface:after{inset:43% 29%;border-color:#9df331;box-shadow:0 0 0 12px rgba(157,243,49,.12)}.plan-surface span{z-index:1;font-size:10px;letter-spacing:.18em}.story h2{font-size:clamp(38px,4.1vw,62px);max-width:660px}.lead{max-width:600px;font-size:16px;line-height:1.45}.journey{display:grid;grid-template-columns:repeat(5,1fr);margin:0;padding:0 8vw 70px;background:#e5e7e0;color:#111310}.journey div{min-height:76px;padding:18px 16px;border:1px solid rgba(17,19,16,.18);border-right:0;font-size:10px;font-weight:600;letter-spacing:.14em}.journey div:last-child{border-right:1px solid rgba(17,19,16,.18)}.journey span{display:block;margin-top:8px;font-size:13px;font-weight:400;letter-spacing:0}.gallery-section{padding:58px 5.5vw 44px;background:#fff;color:#111310}.gallery-section.execution{border-top:1px solid rgba(17,19,16,.18)}.gallery-section h2{font-size:clamp(44px,5vw,72px)}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:28px}.image-button{border:0;padding:0;background:#eef0eb;cursor:zoom-in;overflow:hidden}.image-button img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;transition:transform .45s ease}.image-button:hover img{transform:scale(1.03)}:global(dialog){padding:0;border:0;background:rgba(0,0,0,.93);max-width:100vw;max-height:100vh}:global(dialog::backdrop){background:rgba(0,0,0,.72)}:global(dialog img){display:block;max-width:90vw;max-height:88vh;object-fit:contain}:global(dialog button){position:absolute;right:16px;top:16px;width:42px;height:42px;border:1px solid #fff;border-radius:50%;background:#111;color:#fff;font-size:24px}footer{display:flex;justify-content:space-between;padding:28px 5.5vw;background:#090a09;color:#a5aaa2;font-size:9px;letter-spacing:.16em}@media(max-width:760px){.nav{padding:20px 22px}.nav nav{gap:14px;font-size:9px}.hero{min-height:650px;height:82vh}.hero-copy{padding:0 22px 52px}.meta{left:22px;right:auto;bottom:22px;gap:12px;font-size:8px}.story{grid-template-columns:1fr;padding:56px 22px 36px;gap:28px}.story-plan{min-height:220px}.journey{grid-template-columns:1fr 1fr;padding:0 22px 52px}.journey div:nth-child(2){border-right:1px solid rgba(17,19,16,.18)}.journey div:nth-child(n+3){border-top:0}.gallery-section{padding:48px 22px 34px}.gallery{display:flex;overflow:auto;scroll-snap-type:x mandatory}.image-button{flex:0 0 88vw;scroll-snap-align:start}footer{padding:24px 22px}}
.hero{background:#080a08}.hero-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.76),rgba(0,0,0,.12) 65%,rgba(0,0,0,.3)),linear-gradient(0deg,rgba(0,0,0,.62),transparent 50%)}.hero-copy,.meta{position:relative;z-index:1}.story-plan{min-height:250px}.plan-surface{inset:0;display:block;background:#e5e7e0;border:0;overflow:hidden;transform:none}.plan-surface:before,.plan-surface:after{display:none}.plan-surface img{display:block;width:126%;height:126%;margin:-13%;object-fit:contain;padding:0;opacity:.74;filter:grayscale(1) contrast(1.7) brightness(.78);mix-blend-mode:multiply}.journey{grid-template-columns:repeat(4,1fr)}.rail-shell{margin-top:18px}.gallery{margin-top:0;display:flex;gap:8px;overflow-x:scroll;scroll-snap-type:x mandatory;padding:0 0 12px;scrollbar-color:#8c958d transparent}.image-button{box-sizing:border-box;flex:0 0 calc((100% - 24px)/4);min-width:250px;height:190px;scroll-snap-align:start}.image-button img{width:100%;height:100%;aspect-ratio:auto;object-fit:cover}.rail-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:2px}.rail-arrow{width:38px;height:38px;border:1px solid #111;border-radius:50%;background:transparent;color:#111;font-size:18px;cursor:pointer}.rail-arrow:hover{background:#111;color:#fff}.project-navigation{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:54px 5.5vw;background:#e5e7e0;color:#111310}.project-navigation a{min-height:116px;padding:24px;border:1px solid rgba(17,19,16,.38);display:flex;flex-direction:column;justify-content:center;transition:background .2s,color .2s}.project-navigation a:hover{background:#111310;color:#fff}.return-link{font-size:11px;font-weight:600;letter-spacing:.15em}.next-project{align-items:flex-end;text-align:right}.next-project span{font-size:9px;letter-spacing:.18em;margin-bottom:10px}.next-project strong{font-size:clamp(20px,2.2vw,32px);font-weight:400;letter-spacing:-.04em}:global(dialog){width:100vw;height:100vh;max-width:none;max-height:none;display:none;align-items:center;justify-content:center}:global(dialog[open]){display:flex}:global(dialog img){max-width:86vw;max-height:86vh}:global(dialog .lightbox-close),:global(dialog .lightbox-arrow){z-index:1;position:absolute;width:48px;height:48px;border:1px solid #fff;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:22px;cursor:pointer}:global(dialog .lightbox-close){right:24px;top:24px}:global(dialog .lightbox-arrow){top:50%;transform:translateY(-50%)}:global(dialog .previous){left:24px}:global(dialog .next){right:24px}@media(max-width:760px){.nav{padding:16px 20px;align-items:center}.nav>a{font-size:9px}.nav nav{gap:12px;font-size:8px}.hero{min-height:520px;height:68svh}.hero-copy{padding:0 20px 50px}.hero h1{font-size:clamp(42px,13vw,62px);max-width:360px}.hero-copy>p:last-child{font-size:13px;max-width:330px}.meta{left:20px;bottom:18px;font-size:7px}.story{padding:42px 20px 28px;gap:22px}.story-plan{min-height:190px}.journey{padding:0 20px 40px;grid-template-columns:1fr 1fr}.journey div{min-height:66px;padding:14px 12px}.gallery-section{padding:38px 20px 30px}.gallery-section h2{font-size:54px}.image-button{flex-basis:82vw;min-width:82vw;height:auto;aspect-ratio:16/9}.project-navigation{grid-template-columns:1fr;padding:34px 20px}.project-navigation a{min-height:92px;padding:20px}.next-project{align-items:flex-start;text-align:left}:global(dialog img){max-width:76vw}:global(dialog .previous){left:12px}:global(dialog .next){right:12px}}
</style>
<style>
  .story-plan,.plan-surface{background:transparent!important;border:0!important;box-shadow:none!important}
  .plan-surface{overflow:visible!important}
  .plan-surface img{width:100%!important;height:100%!important;margin:0!important;padding:0!important;object-fit:contain!important;opacity:.52!important;filter:grayscale(1) contrast(2.2) brightness(.8)!important;mix-blend-mode:multiply!important}
  .nav>a{font-size:13px;font-weight:600;letter-spacing:.15em}
  .nav nav{gap:28px}
  @media(max-width:760px){.nav>a{font-size:12px}.nav nav{gap:16px;font-size:9px}}
</style>
<style>@media(max-width:760px){.nav{height:64px;min-height:64px;padding:0 20px;align-items:center;font-size:9px}.nav>a{font-size:9px}.nav nav{gap:12px;font-size:8px}}</style>
