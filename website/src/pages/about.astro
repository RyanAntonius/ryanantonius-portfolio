---
import EditableCopy from '../components/EditableCopy.astro';
---
<EditableCopy />
<style is:global>@media(max-width:760px){header{height:64px!important;min-height:64px!important;padding:0 20px!important;align-items:center!important;font-size:9px!important}header nav{gap:12px!important;font-size:8px!important}}</style>
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>About — Ryan Antonius</title></head>
  <body>
    <header><a class="wordmark" href="/">RYAN ANTONIUS</a><nav><a href="/#work">WORK</a><a href="/#contact">CONTACT</a><a href="/about">ABOUT</a></nav></header>
    <main><p class="eyebrow">ABOUT</p><h1>Design is how I connect ideas with the physical world.</h1><div class="copy"><p>I’m Ryan — a multidisciplinary designer working across retail experiences, event design and industrial design.</p><p>My practice brings strategy, spatial design and execution together to make brands tangible in the real world.</p></div></main>
    <footer id="contact"><span>RYAN ANTONIUS © 2026</span><span>LINKEDIN &nbsp; / &nbsp; EMAIL &nbsp; / &nbsp; INSTAGRAM</span><a href="/#work">BACK TO WORK ↑</a></footer>
  </body>
</html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#f5f3ee;color:#11110f;font-family:Arial,Helvetica,sans-serif}:global(a){color:inherit;text-decoration:none}header{height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(20px,5vw,72px);border-bottom:1px solid #cbc8c0;font-size:10px;font-weight:600;letter-spacing:.18em}header nav{display:flex;gap:27px}main{min-height:calc(100svh - 148px);padding:clamp(95px,14vw,180px) clamp(20px,10vw,150px)}.eyebrow{margin:0 0 20px;font-size:10px;font-weight:600;letter-spacing:.19em}h1{max-width:950px;margin:0;font-size:clamp(54px,8vw,125px);font-weight:400;line-height:.88;letter-spacing:-.075em}.copy{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8vw;max-width:810px;margin-top:62px;font-size:17px;line-height:1.45}.copy p{margin:0}footer{display:flex;justify-content:space-between;gap:20px;padding:22px clamp(20px,5vw,72px);border-top:1px solid #cbc8c0;font-size:9px;letter-spacing:.12em}@media(max-width:760px){header{height:64px;padding:0 20px}header nav{gap:14px;font-size:8px}main{min-height:calc(100svh - 128px);padding:80px 20px}.copy{grid-template-columns:1fr;gap:20px;margin-top:36px;font-size:15px}footer{display:grid;gap:14px;padding:20px;font-size:8px}}</style>
