---
import EditableCopy from '../../components/EditableCopy.astro';
import '../../styles/project-navigation.css';
const projects = {
  'xperion-hamburg': { title:'XPERION Hamburg Shop-In-Shop', hero:'https://static.wixstatic.com/media/97a2bb_2889be8cd373492c84bcb9d46f24d664~mv2.jpg', heading:'A destination for play.', description:'A shop-in-shop concept that brings product, gaming culture and community together in one high-impact environment.', images:['https://static.wixstatic.com/media/97a2bb_2889be8cd373492c84bcb9d46f24d664~mv2.jpg','https://static.wixstatic.com/media/97a2bb_2852890908db48568ee981abeafe8060~mv2.jpg','https://static.wixstatic.com/media/97a2bb_85347e0eb591492e9037f70d41745b01~mv2.jpg','https://static.wixstatic.com/media/97a2bb_ba0823eb9dcc48b7b7aee063cabf91d0~mv2.jpg'], execution:['https://static.wixstatic.com/media/97a2bb_ed13d2a73f8a41a784b3dc3a30aa36d1~mv2.jpg','https://static.wixstatic.com/media/97a2bb_21dc470968cb41c78d4142ad3c74cb82~mv2.jpg','https://static.wixstatic.com/media/97a2bb_4b17ac957fc24cc1bbd7479bc54c9003~mv2.jpg','https://static.wixstatic.com/media/97a2bb_2db4bf8b89384f8ebaf2508f2274bc99~mv2.jpg','https://static.wixstatic.com/media/97a2bb_942d03e0810b4a5fa352a566b1c21788~mv2.jpg'] },
  'ipark-mall': { title:"i'Park Mall", hero:'https://static.wixstatic.com/media/97a2bb_9157a9135ec84a1a8b0e333fa9618e73~mv2.jpg', video:'https://video.wixstatic.com/video/97a2bb_7f30e37d1ab34b5a9f019ce0e8e0b222/1080p/mp4/file.mp4', floorplan:'https://static.wixstatic.com/media/97a2bb_43d3585736f54d2db02af538be12c659~mv2.png', heading:'A retail landmark.', description:'An immersive store concept designed to make the brand unmistakable within a busy mall environment.', images:['https://static.wixstatic.com/media/97a2bb_9157a9135ec84a1a8b0e333fa9618e73~mv2.jpg','https://static.wixstatic.com/media/97a2bb_31bf944b182144a785a0512295c3647c~mv2.jpg','https://static.wixstatic.com/media/97a2bb_49cad2f417cc42aaa21686521d029b6f~mv2.jpg','https://static.wixstatic.com/media/97a2bb_eeeb1dbf2e854967881f2b4520ddce7c~mv2.jpg','https://static.wixstatic.com/media/97a2bb_afabf0b6223043b2b9faf8677c152f84~mv2.jpg'], execution:['https://static.wixstatic.com/media/97a2bb_3f279f80d77242b98d4e1b42b1955441~mv2.jpg','https://static.wixstatic.com/media/97a2bb_0412328ccd2943c09aec718057912248~mv2.jpg','https://static.wixstatic.com/media/97a2bb_27ac0df1cd114031b326590f5d2db483~mv2.jpg','https://static.wixstatic.com/media/97a2bb_b458d27faaf445ac8f7d92a690afcea8~mv2.jpg','https://static.wixstatic.com/media/97a2bb_978c4bb57d354aa9b7f4ad305ae88747~mv2.jpg'] },
  'mark-one': { title:'Mark One', hero:'https://static.wixstatic.com/media/97a2bb_463231c2b57f4fb09d4290d5105180d4~mv2.jpg', video:'https://video.wixstatic.com/video/97a2bb_d7c84b3bdddd4bc295cfa6256493a551/1080p/mp4/file.mp4', floorplan:'https://static.wixstatic.com/media/97a2bb_44b2068f50674fba888ddbd5737aa1bb~mv2.png', heading:'A focused product experience.', description:'A compact retail format that gives every product interaction clarity, confidence and room to perform.', images:['https://static.wixstatic.com/media/97a2bb_463231c2b57f4fb09d4290d5105180d4~mv2.jpg','https://static.wixstatic.com/media/97a2bb_1175eae6d8d945688b6489ba761f2518~mv2.jpg','https://static.wixstatic.com/media/97a2bb_922a0c6966074584b37c01371da4e9ac~mv2.jpg','https://static.wixstatic.com/media/97a2bb_30d1361749cd43aba6f524c2fd3c9c80~mv2.jpg'] },
  'best-buy-inline-display': { title:'Best Buy Inline Display', hero:'https://static.wixstatic.com/media/97a2bb_48f262f29b6b4f9d98a05990c4d3f68c~mv2.jpg', video:'https://video.wixstatic.com/video/97a2bb_a1d1d548500443ff94a34e8c12852070/1080p/mp4/file.mp4', heading:'Big impact, small footprint.', description:'An inline retail display designed to earn attention quickly and make product discovery effortless.', images:['https://static.wixstatic.com/media/97a2bb_48f262f29b6b4f9d98a05990c4d3f68c~mv2.jpg','https://static.wixstatic.com/media/97a2bb_14813d56304f4847adc3755584ac156c~mv2.jpg','https://static.wixstatic.com/media/97a2bb_934d57bdc7a340e0845ecce365c5b1f7~mv2.jpg','https://static.wixstatic.com/media/97a2bb_66e4c7a1bb384957b8327814ef02d6b1~mv2.jpg'], execution:['https://static.wixstatic.com/media/97a2bb_9178aba74c694d529230c1dd129b1e20~mv2.jpg','https://static.wixstatic.com/media/97a2bb_a0456e5778c443be9f8d8d6e7d5fd1f3~mv2.jpg','https://static.wixstatic.com/media/97a2bb_20c07f9cd0e3402b90bcdba0fa4b9db1~mv2.jpeg','https://static.wixstatic.com/media/97a2bb_778789d536bd40b2b3c8b21e9575a039~mv2.jpg','https://static.wixstatic.com/media/97a2bb_a5e480dd9ce84c37a73e2279cdfd8037~mv2.jpeg','https://static.wixstatic.com/media/97a2bb_69070c50a86f47579fca99558b84a34b~mv2.jpg'] },
  'razerstore-chongqing': { title:'RazerStore Chongqing', hero:'https://static.wixstatic.com/media/97a2bb_6876cb3671574fb9aa844325fd044eac~mv2.jpg', floorplan:'https://static.wixstatic.com/media/97a2bb_27cf9f1219134dfcaa6924a5e088b5af~mv2.png', heading:'A flagship built to perform.', description:'A store environment where product, performance and an unmistakable brand presence work as one.', images:['https://static.wixstatic.com/media/97a2bb_6876cb3671574fb9aa844325fd044eac~mv2.jpg','https://static.wixstatic.com/media/97a2bb_abfe849edd6d486baa7ad41a2eae425d~mv2.jpg','https://static.wixstatic.com/media/97a2bb_0a45e32db82e4f8f97b49c05f155cd05~mv2.jpg','https://static.wixstatic.com/media/97a2bb_f1fb7354872d48bd910ac7dbef90ff2e~mv2.jpg','https://static.wixstatic.com/media/97a2bb_dac536b5fb9e4d21bd0f5679e1af5d39~mv2.jpg','https://static.wixstatic.com/media/97a2bb_2611872613f64d4d89b71eaff55022d0~mv2.jpg'], execution:['https://static.wixstatic.com/media/97a2bb_1e72c8566b834e7fb413e0730eae9ca2~mv2.jpg','https://static.wixstatic.com/media/97a2bb_35ade1bb323f413a8a3f95c56d91601e~mv2.jpg','https://static.wixstatic.com/media/97a2bb_8521c2cb8de44ccba76f9250818d919f~mv2.jpg','https://static.wixstatic.com/media/97a2bb_d57f6bab503e4ad9bf1ed2237fb4839d~mv2.jpg'] },
  'razerstore-hefei': { title:'RazerStore Hefei', hero:'https://static.wixstatic.com/media/97a2bb_5665c26fa6d34e9aac33f3986c2e85c4~mv2.jpg', floorplan:'https://static.wixstatic.com/media/97a2bb_baa59c95474044e6852a55083104417f~mv2.png', heading:'A store made for community.', description:'A bold retail destination designed around discovery, play and memorable customer interaction.', images:['https://static.wixstatic.com/media/97a2bb_5665c26fa6d34e9aac33f3986c2e85c4~mv2.jpg','https://static.wixstatic.com/media/97a2bb_7cc52a80d1314195b3f21000475252bc~mv2.jpg','https://static.wixstatic.com/media/97a2bb_ef44c669db54425185816b77e01d3c30~mv2.jpg','https://static.wixstatic.com/media/97a2bb_d9ed7b93101c47328db153a27cdb1c04~mv2.jpg','https://static.wixstatic.com/media/97a2bb_7b432ea472c14bb89b10e108b04013ea~mv2.jpg','https://static.wixstatic.com/media/97a2bb_3461a986b75845afb0b2b7ba0fbb939d~mv2.jpg'], execution:['https://static.wixstatic.com/media/97a2bb_90c19cbb9ea44e4280c4730d84ae995a~mv2.jpg','https://static.wixstatic.com/media/97a2bb_baa8a0d4e152481581607ee1355d17a6~mv2.jpg','https://static.wixstatic.com/media/97a2bb_d494ff2a6a8a46dea382d56321cd922e~mv2.jpg','https://static.wixstatic.com/media/97a2bb_764076b4e84948fba745d186038e9cb3~mv2.jpg','https://static.wixstatic.com/media/97a2bb_75f872a295294aac98eb12daa0c725d5~mv2.jpg'] },
};
const project = projects[Astro.params.slug || 'xperion-hamburg'];
const storyImage = project.floorplan || project.images[0];
const nextProjects = { 'xperion-hamburg': ["i'Park Mall", 'ipark-mall'], 'ipark-mall': ['Mark One', 'mark-one'], 'mark-one': ['Best Buy Inline Display', 'best-buy-inline-display'], 'best-buy-inline-display': ['RazerStore Chongqing', 'razerstore-chongqing'], 'razerstore-chongqing': ['RazerStore Hefei', 'razerstore-hefei'], 'razerstore-hefei': ['RazerStore Taiyuan', '/taiyuan'] };
const nextProject = nextProjects[Astro.params.slug || 'xperion-hamburg'];
---
<EditableCopy />
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{project.title} — Ryan Antonius</title><style>.back-retail{display:inline-flex;margin-top:24px;padding:11px 14px;border:1px solid rgba(255,255,255,.7);font-size:9px;font-weight:600;letter-spacing:.15em;transition:background .2s,color .2s}.back-retail:hover{background:#fff;color:#111310}.shade{background:linear-gradient(90deg,rgba(0,0,0,.82) 0%,rgba(0,0,0,.48) 33%,rgba(0,0,0,.08) 58%,transparent 76%),linear-gradient(0deg,rgba(0,0,0,.36),transparent 48%)}.story-image.floorplan{background:#e5e7e0;overflow:hidden}.story-image.floorplan img{object-fit:contain;padding:4%;filter:grayscale(1) contrast(1.45);opacity:.8;mix-blend-mode:multiply}.gallery{grid-template-columns:repeat(3,minmax(0,1fr))}.image-button{height:auto;aspect-ratio:16/9}@media(max-width:760px){.back-retail{margin-top:18px;padding:9px 11px;font-size:8px}.gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.image-button{aspect-ratio:1}}</style></head><body><header class="nav"><a href="/">RYAN ANTONIUS</a><nav><a href="/retail">WORK</a><a href="#process">PROCESS</a><a href="#images">IMAGES</a></nav></header><main>
<section class="hero" style={`background-image:url(${project.hero})`}>{project.video && <video autoplay muted loop playsinline poster={project.hero}><source src={project.video} type="video/mp4" /></video>}<div class="shade"></div><div class="copy"><p class="eyebrow">RETAIL DESIGN · SELECTED WORK</p><h1>{project.heading}</h1><p>{project.description}</p></div><div class="meta">RETAIL DESIGN <span>2026</span></div></section>
<section class="story" id="process"><div class={`story-image${project.floorplan ? ' floorplan' : ''}`} style={project.floorplan ? 'min-height:380px;background:#e5e7e0' : undefined}><img src={storyImage} alt={project.floorplan ? `${project.title} floorplan` : project.title} style={project.floorplan ? 'width:100%;height:100%;margin:0;opacity:.8;transform:none;mix-blend-mode:multiply' : undefined} /></div><div><p class="eyebrow">CONCEPT DEVELOPMENT · RETAIL STRATEGY</p><h2>Designing the customer journey.</h2><p>Every touchpoint is considered as part of a fluid experience: drawing attention, guiding discovery and creating a compelling reason to stay.</p></div></section>
<section class="steps"><div>01 · ATTRACT <span>Brand presence</span></div><div>02 · DISCOVER <span>Product exploration</span></div><div>03 · EXPERIENCE <span>Hands-on interaction</span></div><div>04 · CONNECT <span>Lasting recall</span></div></section>
<section class="gallery-section" id="images"><p class="eyebrow">DESIGN DEVELOPMENT</p><h2>Renders</h2><div class="gallery" id="gallery">{project.images.map((image,index)=><button class="image-button" data-index={index} data-image={image}><img src={image} alt={`${project.title} render`} /></button>)}</div><div class="actions"><button data-direction="-1">←</button><button data-direction="1">→</button></div></section>
{project.execution && <section class="gallery-section execution"><p class="eyebrow">PROOF OF EXECUTION</p><h2>Built reality</h2><div class="gallery">{project.execution.map((image,index)=><button class="image-button" data-index={index} data-image={image}><img src={image} alt={`${project.title} execution photograph`} /></button>)}</div></section>}
<style>.project-navigation{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:54px 5.5vw;background:#e5e7e0;color:#111310}.project-navigation a{min-height:116px;padding:24px;border:1px solid rgba(17,19,16,.38);display:flex;flex-direction:column;justify-content:center;transition:background .2s,color .2s}.project-navigation a:hover{background:#111310;color:#fff}.return-link{font-size:11px;font-weight:600;letter-spacing:.15em}.next-project{align-items:flex-end;text-align:right}.next-project span{font-size:9px;letter-spacing:.18em;margin-bottom:10px}.next-project strong{font-size:clamp(20px,2.2vw,32px);font-weight:400;letter-spacing:-.04em}footer a{display:none}@media(max-width:760px){.project-navigation{grid-template-columns:1fr;padding:34px 20px}.project-navigation a{min-height:92px;padding:20px}.next-project{align-items:flex-start;text-align:left}}</style><section class="project-navigation"><a class="return-link" href="/retail">← BACK TO RETAIL DESIGN</a>{nextProject && <a class="next-project" href={nextProject[1].startsWith('/') ? nextProject[1] : `/retail/${nextProject[1]}`}><span>NEXT PROJECT</span><strong>{nextProject[0]} →</strong></a>}</section>
</main><footer><span>RYAN ANTONIUS © 2026</span><a href="/retail">BACK TO RETAIL DESIGN ↑</a></footer><dialog id="lightbox"><button class="close">×</button><button class="previous">←</button><img alt="Expanded project image" /><button class="next">→</button></dialog><script>const rail=document.querySelector('#gallery'),dialog=document.querySelector('#lightbox'),large=dialog?.querySelector('img');let index=0,activeGallery,touchX=0,touchY=0;const items=()=>activeGallery?[...activeGallery.querySelectorAll('.image-button')]:[];const show=(step=0)=>{const list=items();if(!list.length)return;index=(index+step+list.length)%list.length;if(large)large.src=list[index]?.dataset.image||''};document.querySelectorAll('.image-button').forEach(item=>item.addEventListener('click',()=>{activeGallery=item.closest('section');const list=items();index=list.indexOf(item);show();dialog?.showModal()}));document.querySelector('.close')?.addEventListener('click',()=>dialog?.close());document.querySelector('.previous')?.addEventListener('click',()=>show(-1));document.querySelector('.next')?.addEventListener('click',()=>show(1));document.addEventListener('keydown',(event)=>{if(!dialog?.open)return;if(event.key==='ArrowLeft'){event.preventDefault();show(-1)}if(event.key==='ArrowRight'){event.preventDefault();show(1)}});dialog?.addEventListener('touchstart',event=>{const touch=event.changedTouches[0];touchX=touch.clientX;touchY=touch.clientY},{passive:true});dialog?.addEventListener('touchend',event=>{const touch=event.changedTouches[0],deltaX=touch.clientX-touchX,deltaY=touch.clientY-touchY;if(Math.abs(deltaX)>48&&Math.abs(deltaX)>Math.abs(deltaY))show(deltaX<0?1:-1)},{passive:true});document.querySelectorAll('.actions button').forEach(button=>button.addEventListener('click',()=>rail?.scrollBy({left:Number(button.dataset.direction||1)*rail.clientWidth*.8,behavior:'smooth'})));</script></body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#111310;color:#fff;font-family:Arial,Helvetica,sans-serif}:global(a){color:inherit;text-decoration:none}.nav{position:absolute;z-index:2;inset:0 0 auto;display:flex;justify-content:space-between;padding:28px 5.5vw;font-size:10px;letter-spacing:.2em}.nav nav{display:flex;gap:26px}.hero{height:88vh;min-height:680px;position:relative;display:flex;align-items:flex-end;background-position:center;background-size:cover;overflow:hidden}.hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.76),rgba(0,0,0,.12) 65%),linear-gradient(0deg,rgba(0,0,0,.68),transparent 48%)}.copy,.meta{position:relative;z-index:1}.copy{max-width:720px;padding:0 5.5vw 68px}.eyebrow{margin:0 0 16px;font-size:10px;font-weight:600;letter-spacing:.2em}.hero h1,.story h2,.gallery-section h2{margin:0;font-weight:400;line-height:.93;letter-spacing:-.065em}.hero h1{font-size:clamp(48px,6vw,88px)}.copy>p:last-child{max-width:480px;margin:18px 0 0;font-size:15px;line-height:1.5;color:#d4d7d2}.meta{position:absolute;right:5.5vw;bottom:36px;display:flex;gap:24px;font-size:9px;letter-spacing:.17em}.story{display:grid;grid-template-columns:minmax(300px,1fr) 1.1fr;gap:7vw;align-items:center;padding:82px 8vw 52px;background:#e5e7e0;color:#111310}.story-image,.story-image img{min-height:280px}.story-image img{width:100%;height:100%;object-fit:cover;display:block}.story h2{font-size:clamp(40px,4.3vw,64px)}.story div:last-child>p:last-child{max-width:580px;font-size:16px;line-height:1.5}.steps{display:grid;grid-template-columns:repeat(4,1fr);padding:0 8vw 70px;background:#e5e7e0;color:#111310}.steps div{min-height:76px;padding:18px 16px;border:1px solid rgba(17,19,16,.18);border-right:0;font-size:10px;font-weight:600;letter-spacing:.14em}.steps div:last-child{border-right:1px solid rgba(17,19,16,.18)}.steps span{display:block;margin-top:8px;font-size:13px;font-weight:400;letter-spacing:0}.gallery-section{padding:58px 5.5vw 44px;background:#fff;color:#111310}.gallery-section h2{font-size:clamp(46px,5vw,72px)}.gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:18px}.image-button{min-width:0;height:190px;padding:0;border:0;background:#eee;cursor:zoom-in;overflow:hidden}.image-button img{width:100%;height:100%;display:block;object-fit:cover}.actions{display:none}footer{display:flex;justify-content:space-between;padding:28px 5.5vw;background:#090a09;color:#a5aaa2;font-size:9px;letter-spacing:.16em}:global(dialog){width:100vw;height:100vh;max-width:none;max-height:none;padding:0;border:0;background:rgba(0,0,0,.93)}:global(dialog[open]){display:flex;align-items:center;justify-content:center}:global(dialog img){max-width:86vw;max-height:86vh;object-fit:contain}:global(dialog button){position:absolute;width:48px;height:48px;border:1px solid #fff;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:22px}:global(dialog .close){top:24px;right:24px}:global(dialog .previous){left:24px}:global(dialog .next){right:24px}@media(max-width:760px){.nav{padding:16px 20px}.nav nav{gap:12px;font-size:8px}.hero{height:68svh;min-height:520px}.copy{padding:0 20px 50px}.hero h1{font-size:clamp(42px,13vw,62px)}.meta{left:20px;right:auto;bottom:18px;font-size:7px}.story{grid-template-columns:1fr;padding:42px 20px 28px;gap:22px}.story-image,.story-image img{min-height:200px}.steps{grid-template-columns:1fr 1fr;padding:0 20px 40px}.steps div{border-right:1px solid rgba(17,19,16,.18)}.gallery-section{padding:38px 20px 30px}.gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.image-button{height:auto;aspect-ratio:1}.gallery-section h2{font-size:54px}}</style>
