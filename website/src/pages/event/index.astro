<EditableCopy />
<style is:global>@media(max-width:760px){header{height:64px!important;min-height:64px!important;padding:0 20px!important;align-items:center!important;font-size:9px!important}header nav{gap:12px!important;font-size:8px!important}}</style>
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Event Design — Ryan Antonius</title></head><body><header><a href="/">RYAN ANTONIUS</a><nav><a href="/#work">WORK</a><a href="/#contact">CONTACT</a><a href="/about">ABOUT</a></nav></header><section class="archive-hero"><div class="archive-rows hero-archive-rows">{archiveRows.map((row,index)=><div class:list={['archive-row',`row-${index + 1}`]}><div class="archive-track">{[...row,...row].map((image,tileIndex)=><figure class="archive-tile"><img src={image} alt="Event project archive" loading={tileIndex < row.length ? 'eager' : 'lazy'} /></figure>)}</div></div>)}</div><div class="hero-copy"><p class="eyebrow">SELECTED WORK</p><h1>Event design</h1><p>Experiences that turn a moment into a lasting brand connection.</p></div></section><main><section class="projects">{projects.map(([title,slug,image],index)=><a class="project" href={`/event/${slug}`}><div><img src={image} alt={title}/></div><p>0{index+1}</p><h2>{title}</h2><span>EVENT DESIGN →</span></a>)}</section></main><footer>RYAN ANTONIUS © 2026</footer><style>.archive-hero:after{background:linear-gradient(90deg,rgba(3,5,3,.72) 0%,rgba(3,5,3,.44) 36%,rgba(3,5,3,.1) 60%,rgba(3,5,3,0) 100%),linear-gradient(0deg,rgba(3,5,3,.3),transparent 55%)}.hero-copy h1{font-size:clamp(48px,6.3vw,96px)}@media(max-width:760px){.archive-hero{min-height:660px!important;display:block!important;background:#f5f4ef;color:#111310}.archive-hero:after{display:none}.hero-archive-rows{inset:auto 0 0!important;height:54%;grid-template-rows:repeat(2,1fr)!important}.hero-archive-rows .archive-row:nth-child(3){display:none}.hero-copy{position:absolute;inset:0 0 auto!important;height:46%;max-width:none!important;padding:48px 20px 28px!important;background:#f5f4ef}.hero-copy h1{font-size:clamp(42px,12vw,58px)!important}.hero-copy>p:last-child{max-width:280px;margin-top:18px!important;color:#383a35}.projects{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:28px 13px!important}.projects .project:first-child{grid-column:1/-1}.projects .project:first-child>div{aspect-ratio:16/10}}</style><style>@media(max-width:760px){.projects .project p{display:block;margin:10px 0 0;font-size:10px}.projects .project h2{display:block;margin:4px 0 0;font-size:12px;line-height:1.15}.projects .project span{margin-top:6px;font-size:9px}.projects .project:first-child h2{font-size:14px}}</style></body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#f5f4ef;color:#111310;font-family:Arial,Helvetica,sans-serif}:global(a){color:inherit;text-decoration:none}header{display:flex;justify-content:space-between;padding:28px 5.5vw;font-size:10px;letter-spacing:.18em}header nav{display:flex;gap:27px}header nav a{color:inherit;text-decoration:none}.eyebrow{font-size:10px;letter-spacing:.2em;font-weight:600}h1{margin:20px 0;font-size:clamp(64px,9vw,140px);font-weight:400;letter-spacing:-.075em;line-height:.85}.archive-hero{position:relative;isolation:isolate;display:flex;align-items:flex-end;min-height:clamp(520px,70vh,760px);overflow:hidden;background:#111310;color:#f5f4ef}.hero-archive-rows{position:absolute;inset:0;z-index:-2;display:grid;grid-template-rows:repeat(3,1fr);gap:8px;padding:8px 0}.archive-row{overflow:hidden}.archive-track{display:flex;width:max-content;gap:8px;height:100%}.archive-row.row-1 .archive-track{animation:archive-left 48s linear infinite}.archive-row.row-2 .archive-track{animation:archive-right 54s linear infinite}.archive-row.row-3 .archive-track{animation:archive-left 46s linear infinite}.archive-tile{width:clamp(220px,26vw,390px);height:100%;flex:none;margin:0;overflow:hidden;background:#060806}.archive-tile img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(.86) contrast(1.07);transition:transform .5s ease}.archive-tile:hover img{transform:scale(1.06)}.archive-hero:after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(3,5,3,.9) 0%,rgba(3,5,3,.67) 40%,rgba(3,5,3,.22) 72%,rgba(3,5,3,.5)),linear-gradient(0deg,rgba(3,5,3,.55),transparent 55%)}.hero-copy{padding:clamp(55px,8vw,120px) 5.5vw;max-width:900px}.hero-copy>p:last-child{max-width:430px;margin:36px 0 0;font-size:18px;line-height:1.4}main{padding:90px 5.5vw}.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:56px 18px}.project>div{aspect-ratio:1;overflow:hidden;background:#ddd}.project img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .4s}.project:hover img{transform:scale(1.04)}.project p{display:inline-block;margin:14px 30px 0 0;font-size:12px}.project h2{display:inline;font-size:18px;font-weight:400}.project span{display:block;margin-top:8px;font-size:9px;letter-spacing:.15em}@keyframes archive-left{to{transform:translateX(-50%)}}@keyframes archive-right{from{transform:translateX(-50%)}to{transform:translateX(0)}}footer{padding:28px 5.5vw;background:#090a09;color:#a5aaa2;font-size:9px;letter-spacing:.16em}@media(max-width:760px){header{padding:20px}header nav{gap:14px;font-size:8px}.archive-hero{min-height:580px}.hero-archive-rows{gap:5px;padding:5px 0}.archive-tile{width:250px}.hero-copy{padding:70px 20px 58px}.hero-copy>p:last-child{font-size:14px;margin-top:26px}main{padding:58px 20px}.projects{grid-template-columns:1fr;gap:40px}}@media(prefers-reduced-motion:reduce){.archive-track{animation:none!important}}</style>
