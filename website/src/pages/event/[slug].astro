export function getStaticPaths() {
  return ['ces-2025', 'brasil-game-show-2023', 'chinajoy-2026', 'bilibili-world-2024', 'commart-thailand-2024', 'thailand-game-show-2024', 'taipei-game-show-2024', 'razer-live-sea-hq', 'endix-virtual-expo-2024'].map((slug) => ({ params: { slug } }));
}
const slug = Astro.params.slug || 'ces-2025'; const project = projects[slug] || projects['ces-2025'];
const order = Object.keys(projects); const nextSlug = order[(order.indexOf(slug) + 1) % order.length]; const next = projects[nextSlug];
const floorplans = {'ces-2025':'/assets/ces-2025-floorplan.jpg','brasil-game-show-2023':'/assets/bgs-2023-floorplan.png','commart-thailand-2024':'/assets/commart-thailand-2024-floorplan.png','thailand-game-show-2024':'/assets/thailand-game-show-2024-floorplan.png','taipei-game-show-2024':'/assets/taipei-game-show-2024-floorplan.png'};
const floorplan = floorplans[slug];
const heroImage = slug === 'chinajoy-2026' ? '/assets/chinajoy-2026-hero.jpg' : project.hero;
const processImage = slug === 'chinajoy-2026' ? '/assets/chinajoy-2026-process.jpg' : floorplan || project.renders[0];
const renders = slug === 'chinajoy-2026' ? [...project.renders.slice(0,5),'/assets/chinajoy-2026-755.jpg','/assets/chinajoy-2026-754-7.jpg','/assets/chinajoy-2026-754-10.jpg'] : project.renders;
const execution = slug === 'chinajoy-2026' ? [...(project.poe || []),'/assets/chinajoy-2026-poe-54.jpg'] : project.poe;
---
<EditableCopy />
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{project.title} — Ryan Antonius</title></head><body>
<header><a href="/">RYAN ANTONIUS</a><nav><a href="/event">WORK</a><a href="#renders">IMAGES</a></nav></header><main>
<section class="hero" style={`background-image:url(${heroImage})`}>{project.video && <video autoplay muted loop playsinline poster={heroImage}><source src={project.video} type="video/mp4"/></video>}<div class="shade"></div><div class="copy"><p>EVENT DESIGN · SELECTED WORK</p><h1>{project.heading}</h1><span>{project.title}</span></div></section>
<section class="intro" id="process"><div class:list={['process-image',{floorplan:!!floorplan}]}><img src={processImage} alt={floorplan ? `${project.title} floorplan` : `${project.title} concept render`}/></div><div class="intro-copy"><p>EVENT DESIGN · EXPERIENCE STRATEGY</p><h2>Bringing audiences into the story.</h2><p>From the first invitation to the final interaction, every detail is designed to create a memorable shared experience.</p></div></section>
<section class="journey"><div>01 · INVITE <span>First impression</span></div><div>02 · DISCOVER <span>Brand story</span></div><div>03 · ENGAGE <span>Hands-on moments</span></div><div>04 · REMEMBER <span>Lasting connection</span></div></section>
<style>.intro{grid-template-columns:minmax(300px,1fr) 1.1fr;gap:7vw;align-items:center;padding:82px 8vw 52px}.process-image{min-height:280px;background:#dfe2db;overflow:hidden}.process-image img{width:100%;height:100%;min-height:280px;display:block;object-fit:cover;filter:saturate(.82)}.process-image.floorplan{background:#e5e7e0}.process-image.floorplan img{object-fit:contain;filter:none}.intro-copy>p:first-child{margin:0 0 16px;font-size:10px;letter-spacing:.2em;font-weight:600}.intro-copy h2{font-size:clamp(40px,4.3vw,64px)}.intro-copy>p:last-child{margin:20px 0 0;max-width:580px;font-size:16px;line-height:1.5}.journey{display:grid;grid-template-columns:repeat(4,1fr);padding:0 8vw 70px;background:#e5e7e0;color:#111310}.journey div{min-height:76px;padding:18px 16px;border:1px solid rgba(17,19,16,.18);border-right:0;font-size:10px;font-weight:600;letter-spacing:.14em}.journey div:last-child{border-right:1px solid rgba(17,19,16,.18)}.journey span{display:block;margin-top:8px;font-size:13px;font-weight:400;letter-spacing:0}@media(max-width:760px){.intro{grid-template-columns:1fr;padding:42px 20px 28px;gap:22px}.process-image,.process-image img{min-height:200px}.journey{grid-template-columns:1fr 1fr;padding:0 20px 40px}.journey div{min-height:66px;padding:14px 12px}.journey div:nth-child(2){border-right:1px solid rgba(17,19,16,.18)}.journey div:nth-child(n+3){border-top:0}}</style>
<section class="gallery-section" id="renders"><p>DESIGN DEVELOPMENT</p><h2>Renders</h2><div class="gallery">{renders.map((image,index)=><button class="image-button" data-image={image} data-index={index}><img src={image} alt={`${project.title} render`}/></button>)}</div></section>
{execution && <section class="gallery-section execution"><p>PROOF OF EXECUTION</p><h2>Built reality</h2><div class="gallery">{execution.map((image,index)=><button class="image-button" data-image={image} data-index={index}><img src={image} alt={`${project.title} event photograph`}/></button>)}</div></section>}
<section class="project-navigation"><a href="/event">← BACK TO EVENT DESIGN</a><a href={`/event/${nextSlug}`}><span>NEXT PROJECT</span><strong>{next.title} →</strong></a></section>
</main><footer>RYAN ANTONIUS © 2026</footer><dialog id="lightbox"><button class="close">×</button><button class="previous">←</button><img alt="Expanded image"/><button class="next">→</button></dialog><script>const modal=document.querySelector('#lightbox'),large=modal?.querySelector('img');let active=0,activeGallery,touchX=0,touchY=0;const items=()=>activeGallery?[...activeGallery.querySelectorAll('.image-button')]:[];const show=(step=0)=>{const list=items();if(!list.length)return;active=(active+step+list.length)%list.length;if(large)large.src=list[active]?.dataset.image||''};document.querySelectorAll('.image-button').forEach(item=>item.addEventListener('click',()=>{activeGallery=item.closest('section');const list=items();active=list.indexOf(item);show();modal?.showModal()}));document.querySelector('.close')?.addEventListener('click',()=>modal?.close());document.querySelector('.previous')?.addEventListener('click',()=>show(-1));document.querySelector('.next')?.addEventListener('click',()=>show(1));document.addEventListener('keydown',(e)=>{if(!modal?.open)return;if(e.key==='ArrowLeft')show(-1);if(e.key==='ArrowRight')show(1)});modal?.addEventListener('touchstart',event=>{const touch=event.changedTouches[0];touchX=touch.clientX;touchY=touch.clientY},{passive:true});modal?.addEventListener('touchend',event=>{const touch=event.changedTouches[0],deltaX=touch.clientX-touchX,deltaY=touch.clientY-touchY;if(Math.abs(deltaX)>48&&Math.abs(deltaX)>Math.abs(deltaY))show(deltaX<0?1:-1)},{passive:true});</script></body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#111310;color:#fff;font-family:Arial,Helvetica,sans-serif}:global(a){color:inherit;text-decoration:none}header{position:absolute;z-index:2;inset:0 0 auto;display:flex;justify-content:space-between;padding:28px 5.5vw;font-size:10px;letter-spacing:.2em}header nav{display:flex;gap:26px}.hero{position:relative;height:88vh;min-height:680px;display:flex;align-items:flex-end;background-size:cover;background-position:center;overflow:hidden}.hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.82),rgba(0,0,0,.12) 65%),linear-gradient(0deg,rgba(0,0,0,.6),transparent 48%)}.copy{position:relative;padding:0 5.5vw 68px;max-width:750px}.copy p,.intro>p:first-child,.gallery-section>p{margin:0 0 16px;font-size:10px;letter-spacing:.2em;font-weight:600}.copy h1,.intro h2,.gallery-section h2{margin:0;font-weight:400;line-height:.93;letter-spacing:-.065em}.copy h1{font-size:clamp(48px,6vw,88px)}.copy span{display:block;margin-top:22px;font-size:13px;color:#d5d8d2}.intro{display:grid;grid-template-columns:1fr 1fr;gap:8vw;padding:84px 8vw 72px;background:#e5e7e0;color:#111310}.intro h2{font-size:clamp(42px,4.5vw,68px);grid-column:1}.intro>p:last-child{margin:0;align-self:end;max-width:520px;font-size:16px;line-height:1.5}.gallery-section{padding:58px 5.5vw;background:#fff;color:#111310}.execution{border-top:1px solid #d6d5cf}.gallery-section h2{font-size:clamp(46px,5vw,72px)}.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:20px}.image-button{padding:0;border:0;background:#eee;aspect-ratio:16/9;cursor:zoom-in;overflow:hidden}.image-button img{display:block;width:100%;height:100%;object-fit:cover}.project-navigation{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:54px 5.5vw;background:#e5e7e0;color:#111310}.project-navigation a{min-height:116px;padding:24px;border:1px 